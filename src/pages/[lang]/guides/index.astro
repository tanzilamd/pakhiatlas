---
import Layout from '../../../layouts/Layout.astro';import {getCollection} from 'astro:content';import {url,t,type Lang} from '../../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;const priority=['cockatiel-feeding','seed-mix','balanced-diet','food-transition','first-bird','travel-care'];const guides=(await getCollection('guides')).filter(g=>g.data.language===lang).sort((a,b)=>{const rank=(slug:string)=>{const i=priority.indexOf(slug);return i<0?99:i};return rank(a.data.slug)-rank(b.data.slug)});
---
<Layout lang={lang} title={t(lang,'Care library','যত্নের পাঠাগার')} path="guides/"><section class="page-intro"><span class="eyebrow">{t(lang,'A LITTLE EVERY DAY','প্রতিদিন একটু যত্ন')}</span><h1>{t(lang,'Care is something we learn.','যত্নও শেখার বিষয়।')}</h1><p>{t(lang,'Practical reading for a more thoughtful life with birds, from the first day at home to everyday feeding, behaviour and health.','পাখি ঘরে আনার প্রস্তুতি থেকে খাবার, আচরণ ও অসুস্থতার লক্ষণ—প্রয়োজনের সময় কাজে লাগে এমন পরিচর্যার পাঠ।')}</p></section><section class="section guide-grid">{guides.map((g,i)=><a class="guide-card" href={url(`${lang}/guides/${g.data.slug}/`)}><span class="guide-number">{String(i+1).padStart(2,'0')}</span><h2>{g.data.title}</h2><p>{g.data.summary}</p><span class="text-link">{t(lang,'Read guide','পড়ুন')} →</span></a>)}</section></Layout>
