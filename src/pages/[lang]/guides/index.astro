---
import Layout from '../../../layouts/Layout.astro';import {getCollection} from 'astro:content';import {url,t,type Lang} from '../../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;const guides=(await getCollection('guides')).filter(g=>g.data.language===lang);
---
<Layout lang={lang} title={t(lang,'Care library','যত্নের পাঠাগার')} path="guides/"><section class="page-intro"><span class="eyebrow">{t(lang,'A LITTLE EVERY DAY','প্রতিদিন একটু যত্ন')}</span><h1>{t(lang,'Care is something we learn.','যত্নও শেখার বিষয়।')}</h1><p>{t(lang,'Practical reading for a more thoughtful life with birds. All entries remain editorial drafts pending source verification.','পাখির সঙ্গে আরও সচেতন জীবনের ব্যবহারিক পাঠ। মূল উৎস যাচাই না হওয়া পর্যন্ত সব লেখা সম্পাদনাধীন খসড়া।')}</p></section><section class="section guide-grid">{guides.map((g,i)=><a class="guide-card" href={url(`${lang}/guides/${g.data.slug}/`)}><span class="guide-number">{String(i+1).padStart(2,'0')}</span><h2>{g.data.title}</h2><p>{g.data.summary}</p><span class="text-link">{t(lang,'Read guide','পড়ুন')} →</span></a>)}</section></Layout>
