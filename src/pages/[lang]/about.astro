---
import Layout from '../../layouts/Layout.astro';import {t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,"About PakhiAtlas","PakhiAtlas সম্পর্কে")} path="about/"><section class="page-intro"><h1>{t(lang,"About PakhiAtlas","PakhiAtlas সম্পর্কে")}</h1></section><section class="section prose"><p>{t(lang,"PakhiAtlas is an independent bilingual educational project for Bangladesh. It is not a shop, clinic or marketplace. No accounts, tracking, advertisements or runtime APIs are used. You can suggest corrections through the GitHub repository.","PakhiAtlas বাংলাদেশের জন্য স্বাধীন দ্বিভাষিক শিক্ষামূলক প্রকল্প। এটি দোকান, ক্লিনিক বা বাজার নয়। অ্যাকাউন্ট, ট্র্যাকিং, বিজ্ঞাপন বা রানটাইম API নেই। GitHub-এ সংশোধনের প্রস্তাব দিতে পারেন।")}</p><p><a href="https://github.com/tanzilamd/pakhiatlas">GitHub — tanzilamd/pakhiatlas →</a></p></section></Layout>
