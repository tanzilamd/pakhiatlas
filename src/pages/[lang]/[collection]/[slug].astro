---
import PriceInfo from '../../../components/PriceInfo.astro';import Layout from '../../../layouts/Layout.astro';import PhotoGallery from '../../../components/PhotoGallery.astro';import {getCollection,render} from 'astro:content';import {primaryPhoto} from '../../../data/media';import VarietyGuide from '../../../components/VarietyGuide.astro';import varieties from '../../../data/varieties.json';import birds from '../../../data/birds.json';import wildlife from '../../../data/wildlife.json';import {url,t,type Lang,labels} from '../../../data/site';
export async function getStaticPaths(){const all=await Promise.all(['birds','guides','wildlife'].map(async c=>(await getCollection(c as 'birds'|'guides'|'wildlife')).map(entry=>({params:{lang:entry.data.language,collection:c,slug:entry.data.slug},props:{entry}}))));return all.flat()}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const lang=entry.data.language as Lang;const collection=Astro.params.collection!;const bird=[...birds,...wildlife].find(b=>b.slug===entry.data.slug);const path=`${collection}/${entry.data.slug}/`;
const leadPhoto=primaryPhoto(entry.data.slug);const hasVarieties=varieties.some(v=>v.species===entry.data.slug);
const related=(await getCollection('guides')).filter(g=>g.data.language===lang&&g.data.slug!==entry.data.slug&&(entry.data.slug==='cockatiel'?['cockatiel-feeding','seed-mix','daily-routine','droppings','dhaka-bird-budget']:entry.data.slug==='budgerigar'?['seed-mix','balanced-diet','trust-training','dhaka-bird-budget']:entry.data.slug.includes('conure')?['trust-training','enrichment','multiple-birds','dhaka-bird-budget']:entry.data.slug.includes('lovebird')?['multiple-birds','breeding-readiness','balanced-diet','dhaka-bird-budget']:['first-bird','balanced-diet','illness-emergency','droppings']).includes(g.data.slug));
const articleUrl=new URL(url(`${lang}/${path}`),Astro.site).href;
const schema={'@context':'https://schema.org','@type':'Article',headline:entry.data.title,dateModified:entry.data.reviewedAt.toISOString(),...(leadPhoto?{image:new URL(url(leadPhoto.src),Astro.site).href}:{}),inLanguage:lang,url:articleUrl,publisher:{'@type':'Organization',name:'PakhiAtlas'}};
const crumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'PakhiAtlas',item:new URL(url(`${lang}/`),Astro.site).href},{'@type':'ListItem',position:2,name:collection,item:new URL(url(`${lang}/${collection==='wildlife'?'birds':collection}/`),Astro.site).href},{'@type':'ListItem',position:3,name:entry.data.title,item:articleUrl}]};
---
<Layout lang={lang} image={leadPhoto?{src:leadPhoto.src,alt:lang==='bn'?leadPhoto.altBn:leadPhoto.altEn,width:leadPhoto.width,height:leadPhoto.height}:undefined} title={entry.data.title} description={entry.data.summary} path={path} article><script type="application/ld+json" set:html={JSON.stringify(schema)}/><script type="application/ld+json" set:html={JSON.stringify(crumbs)}/><div class="article-shell"><nav class="breadcrumbs" aria-label={t(lang,'Breadcrumb','পথনির্দেশ')}><a href={url(`${lang}/`)}>{t(lang,'Home','শুরু')}</a> / <a href={url(`${lang}/${collection==='wildlife'?'birds':collection}/`)}>{collection==='birds'?t(lang,'Birds','পাখি'):collection==='wildlife'?t(lang,'Native birds','দেশীয় পাখি'):t(lang,'Care guides','যত্নের গাইড')}</a> / <span>{entry.data.title}</span></nav><div class="article-header"><span class="eyebrow">{collection==='wildlife'?t(lang,'NATURE & CONSERVATION','প্রকৃতি ও সংরক্ষণ'):collection==='guides'?t(lang,'THE CARE LIBRARY','যত্নের পাঠাগার'):t(lang,'PAKHIATLAS • SPECIES PROFILE','পাখির পরিচিতি')}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1>{bird&&<p class="scientific">{bird.en} · {bird.scientificName}</p>}{!bird&&<p class="lede">{entry.data.summary}</p>}<p class="muted">{t(lang,'Last edited','শেষ সম্পাদনা')}: {new Intl.DateTimeFormat(lang==='bn'?'bn-BD':'en-GB',{dateStyle:'long',timeZone:'UTC'}).format(entry.data.reviewedAt)}</p><div class="article-actions">{bird&&collection==='birds'&&<a href={url(`${lang}/tools/?compare=${bird.slug},${bird.slug==='budgerigar'?'cockatiel':'budgerigar'}#compare`)}>{t(lang,'Compare this bird','এই পাখির সঙ্গে তুলনা')}</a>}<button data-copy>{t(lang,'Copy link','লিংক কপি')}</button><button data-bookmark data-key={entry.data.slug} data-collection={collection} aria-pressed="false">{t(lang,'Save for later','পরে পড়ব')}</button><a href={url(`${lang}/saved/`)}>{t(lang,'Reading list','পড়ার তালিকা')}</a><button data-print>{t(lang,'Print','প্রিন্ট')}</button><span role="status" id="action-status"></span></div></div><div class="article-grid"><aside class="toc"><details data-toc><summary><strong>{t(lang,'IN THIS ARTICLE','এই লেখায়')}</strong></summary>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}{hasVarieties&&<a href="#varieties">{t(lang,'Colours & varieties','রং ও জাতের পরিচিতি')}</a>}</details></aside><article class="prose" data-pagefind-body><span class="sr-only" data-pagefind-weight="10">{bird?.aliases} {bird?.scientificName} {bird?.en} {bird?.bn}</span>{bird&&<><PhotoGallery species={bird.slug} lang={lang}/><dl class="facts"><div><dt>{t(lang,'Taxonomic family','বৈজ্ঞানিক পরিবার')}</dt><dd>{bird.taxonomicFamily}</dd></div><div><dt>{t(lang,'Size class','আকার')}</dt><dd>{labels[bird.size as keyof typeof labels][lang==='en'?0:1]}</dd></div><div><dt>{t(lang,'Typical sound','সাধারণ ডাক')}</dt><dd>{labels[bird.noise as keyof typeof labels][lang==='en'?0:1]}</dd></div>{collection==='birds'&&<div><dt>{t(lang,'Care experience','যত্নের অভিজ্ঞতা')}</dt><dd>{labels[bird.experience as keyof typeof labels][lang==='en'?0:1]}</dd></div>}</dl></>}{entry.data.slug==='droppings'&&<figure><img src={url('illustrations/droppings.svg')} width="760" height="360" alt={t(lang,'Schematic showing feces, urates and surrounding liquid urine; not a diagnostic chart','মল, ইউরেট ও চারপাশের তরল মূত্রের চিত্র; রোগ নির্ণয়ের তালিকা নয়')}/></figure>}{collection==='birds'&&<PriceInfo species={entry.data.slug} lang={lang}/>}<Content/>{bird&&<VarietyGuide species={bird.slug} lang={lang}/>}<h2>{t(lang,'Keep reading','আরও পড়ুন')}</h2><ul>{related.map(g=><li><a href={url(`${lang}/guides/${g.data.slug}/`)}>{g.data.title}</a></li>)}</ul></article></div></div></Layout>
<script>
const toc=document.querySelector<HTMLDetailsElement>('[data-toc]');if(toc)toc.open=matchMedia('(min-width:701px)').matches;
import {readBookmarks,writeBookmarks,identity,type Bookmark} from '../../../lib/bookmarks';
const bn=document.documentElement.lang==='bn';const status=document.querySelector('#action-status')!;
document.querySelector('[data-copy]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);status.textContent=bn?'লিংক কপি হয়েছে':'Link copied'}catch{status.textContent=location.href}});
document.querySelector('[data-print]')?.addEventListener('click',()=>window.print());
const button=document.querySelector<HTMLButtonElement>('[data-bookmark]');
if(button){const entry:Bookmark={collection:button.dataset.collection as Bookmark['collection'],slug:button.dataset.key!};
const refresh=()=>{const saved=readBookmarks().some(b=>identity(b)===identity(entry));button.setAttribute('aria-pressed',String(saved));button.textContent=bn?(saved?'তালিকায় আছে ✓':'পরে পড়ব'):(saved?'Saved ✓':'Save for later')};refresh();
button.addEventListener('click',()=>{const all=readBookmarks();const saved=all.some(b=>identity(b)===identity(entry));const next=saved?all.filter(b=>identity(b)!==identity(entry)):[...all,entry];if(writeBookmarks(next)){refresh();status.textContent=bn?(saved?'তালিকা থেকে সরানো হয়েছে':'পড়ার তালিকায় যোগ হয়েছে'):(saved?'Removed from reading list':'Added to reading list')}else status.textContent=bn?'ব্রাউজারে সংরক্ষণ বন্ধ আছে':'Browser storage is unavailable'});}
</script>
