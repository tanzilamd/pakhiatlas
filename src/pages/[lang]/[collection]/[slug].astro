---
import Layout from '../../../layouts/Layout.astro';import PhotoGallery from '../../../components/PhotoGallery.astro';import {getCollection,render} from 'astro:content';import birds from '../../../data/birds.json';import wildlife from '../../../data/wildlife.json';import {references} from '../../../data/references';import {url,t,type Lang,labels} from '../../../data/site';
export async function getStaticPaths(){const all=await Promise.all(['birds','guides','wildlife'].map(async c=>(await getCollection(c as 'birds'|'guides'|'wildlife')).map(entry=>({params:{lang:entry.data.language,collection:c,slug:entry.data.slug},props:{entry}}))));return all.flat()}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const lang=entry.data.language as Lang;const collection=Astro.params.collection!;const bird=[...birds,...wildlife].find(b=>b.slug===entry.data.slug);const path=`${collection}/${entry.data.slug}/`;
const related=(await getCollection('guides')).filter(g=>g.data.language===lang&&g.data.slug!==entry.data.slug&&['first-bird','balanced-diet','breeding-readiness','responsible-acquisition','illness-emergency','droppings'].includes(g.data.slug));
const articleUrl=new URL(url(`${lang}/${path}`),Astro.site).href;
const schema={'@context':'https://schema.org','@type':'Article',headline:entry.data.title,inLanguage:lang,url:articleUrl,publisher:{'@type':'Organization',name:'PakhiAtlas'}};
const crumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'PakhiAtlas',item:new URL(url(`${lang}/`),Astro.site).href},{'@type':'ListItem',position:2,name:collection,item:new URL(url(`${lang}/${collection}/`),Astro.site).href},{'@type':'ListItem',position:3,name:entry.data.title,item:articleUrl}]};
---
<Layout lang={lang} title={entry.data.title} description={entry.data.summary} path={path} article><script type="application/ld+json" set:html={JSON.stringify(schema)}/><script type="application/ld+json" set:html={JSON.stringify(crumbs)}/><div class="article-shell"><nav class="breadcrumbs" aria-label={t(lang,'Breadcrumb','পথনির্দেশ')}><a href={url(`${lang}/`)}>{t(lang,'Home','শুরু')}</a> / <a href={url(`${lang}/${collection}/`)}>{collection==='birds'?t(lang,'Birds','পাখি'):collection==='wildlife'?t(lang,'Native birds','দেশীয় পাখি'):t(lang,'Care guides','যত্নের গাইড')}</a> / <span>{entry.data.title}</span></nav><div class="article-header"><span class="eyebrow">{t(lang,'PAKHIATLAS • FIELD GUIDE','পাখি পরিচিতি ও যত্ন')}</span><h1 data-pagefind-meta="title">{entry.data.title}</h1>{bird&&<p class="scientific">{bird.en} · {bird.scientificName}</p>}{!bird&&<p class="lede">{entry.data.summary}</p>}<p class="muted">{t(lang,'Last edited','শেষ সম্পাদনা')}: {new Intl.DateTimeFormat(lang==='bn'?'bn-BD':'en-GB',{dateStyle:'long',timeZone:'UTC'}).format(entry.data.reviewedAt)}</p><div class="article-actions"><button data-copy>{t(lang,'Copy link','লিংক কপি')}</button><button data-bookmark data-key={entry.data.slug}>{t(lang,'Save locally','এই ব্রাউজারে রাখুন')}</button><button data-print>{t(lang,'Print','প্রিন্ট')}</button><span role="status" id="action-status"></span></div></div><div class="article-grid"><aside class="toc"><strong>{t(lang,'IN THIS ARTICLE','এই লেখায়')}</strong>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#references">{t(lang,'References','তথ্যসূত্র')}</a></aside><article class="prose" data-pagefind-body><span class="sr-only" data-pagefind-weight="10">{bird?.aliases} {bird?.scientificName} {bird?.en} {bird?.bn}</span>{bird&&<><PhotoGallery species={bird.slug} lang={lang}/><dl class="facts"><div><dt>{t(lang,'Taxonomic family','বৈজ্ঞানিক পরিবার')}</dt><dd>{bird.taxonomicFamily}</dd></div><div><dt>{t(lang,'Size class','আকার')}</dt><dd>{labels[bird.size as keyof typeof labels][lang==='en'?0:1]}</dd></div><div><dt>{t(lang,'Typical sound','সাধারণ ডাক')}</dt><dd>{labels[bird.noise as keyof typeof labels][lang==='en'?0:1]}</dd></div>{collection==='birds'&&<div><dt>{t(lang,'Care experience','যত্নের অভিজ্ঞতা')}</dt><dd>{labels[bird.experience as keyof typeof labels][lang==='en'?0:1]}</dd></div>}</dl></>}{entry.data.slug==='droppings'&&<figure><img src={url('illustrations/droppings.svg')} width="760" height="360" alt={t(lang,'Schematic showing feces, urates and surrounding liquid urine; not a diagnostic chart','মল, ইউরেট ও চারপাশের তরল মূত্রের চিত্র; রোগ নির্ণয়ের তালিকা নয়')}/></figure>}<Content/><h2 id="references">{t(lang,'References & further reading','তথ্যসূত্র ও আরও পড়ুন')}</h2><ol>{entry.data.sources.map((key:string)=><li><a href={references[key].url} rel="external">{references[key].name} →</a></li>)}</ol><h2>{t(lang,'Keep reading','আরও পড়ুন')}</h2><ul>{related.map(g=><li><a href={url(`${lang}/guides/${g.data.slug}/`)}>{g.data.title}</a></li>)}</ul></article></div></div></Layout>
<script>
const status=document.querySelector('#action-status')!;document.querySelector('[data-copy]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);status.textContent=document.documentElement.lang==='bn'?'কপি হয়েছে':'Link copied'}catch{status.textContent=location.href}});document.querySelector('[data-print]')?.addEventListener('click',()=>window.print());document.querySelector<HTMLButtonElement>('[data-bookmark]')?.addEventListener('click',e=>{const b=e.currentTarget as HTMLButtonElement;try{const key='saved:'+b.dataset.key;const saved=localStorage.getItem(key);if(saved)localStorage.removeItem(key);else localStorage.setItem(key,location.pathname);b.setAttribute('aria-pressed',String(!saved));status.textContent=document.documentElement.lang==='bn'?(saved?'সরানো হয়েছে':'এই ব্রাউজারে রাখা হয়েছে'):(saved?'Removed':'Saved in this browser')}catch{status.textContent=document.documentElement.lang==='bn'?'ব্রাউজারে সংরক্ষণ বন্ধ আছে':'Browser storage is unavailable'}});
</script>
