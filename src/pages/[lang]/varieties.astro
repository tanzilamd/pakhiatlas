---
import Layout from '../../layouts/Layout.astro';import VarietyGuide from '../../components/VarietyGuide.astro';import birds from '../../data/birds.json';import wildlife from '../../data/wildlife.json';import varieties from '../../data/varieties.json';import {url,t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Species, colours & domestic varieties','প্রজাতি, রং ও গৃহপালিত জাত')} path="varieties/"><section class="page-intro"><h1>{t(lang,'A different colour. The same species.','রং আলাদা, প্রজাতি এক।')}</h1><p>{t(lang,'Market names mix species, colour mutations and domestic types. Start with the species, then record the variety separately. Colours do not guarantee temperament, talking or health.','বাজারি নামে প্রজাতি, রঙের মিউটেশন আর গৃহপালিত জাত প্রায়ই মিশে যায়। আগে প্রজাতি চিনুন, তারপর রং বা জাতের পরিচয় আলাদা করে লিখুন। রং দিয়ে স্বভাব, কথা বলা বা স্বাস্থ্য নিশ্চিত হয় না।')}</p></section><section class="section"><VarietyGuide lang={lang}/><div class="chips">{[...new Set(varieties.map(v=>v.species))].map(slug=>{const b=[...birds,...wildlife].find(b=>b.slug===slug)!;const group=wildlife.some(w=>w.slug===slug)?'wildlife':'birds';return <a href={url(`${lang}/${group}/${slug}/`)}>{b[lang]} →</a>})}</div></section></Layout>
