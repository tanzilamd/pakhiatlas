---
import Layout from '../../layouts/Layout.astro';import {url,t,type Lang} from '../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;const target=url(`${lang}/birds/`);
---
<Layout lang={lang} title={t(lang,'Bird encyclopedia','পাখির বিশ্বকোষ')} path="varieties/" noindex><meta http-equiv="refresh" content={`0;url=${target}`}/><section class="page-intro"><h1>{t(lang,'All birds, together','সব পাখি এক জায়গায়')}</h1><p><a href={target}>{t(lang,'Open the bird encyclopedia','পাখির বিশ্বকোষে যান')} →</a></p></section></Layout>
