---
import BirdCard from '../../components/BirdCard.astro';import Layout from '../../layouts/Layout.astro';import wildlife from '../../data/wildlife.json';import {t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,"Wild birds & conservation","বন্য পাখি ও সংরক্ষণ")} path="wildlife/"><section class="page-intro"><h1>{t(lang,"Wild birds & conservation","বন্য পাখি ও সংরক্ষণ")}</h1></section><section class="section"><div class="bird-grid">{wildlife.map(b=><BirdCard bird={b} lang={lang}/>)}</div></section><section class="section prose"><p>{t(lang,'Native and migratory birds have a conservation context, separate from domestic companion birds. A bird seen in a market is not automatically a lawful captive-bred pet. Avoid wild-caught birds and check lawful provenance.','দেশীয় ও পরিযায়ী পাখির বিষয়টি সংরক্ষণের, গৃহপালিত সঙ্গী পাখির থেকে আলাদা। হাটে দেখা পাখি মানেই বৈধ বন্দী-প্রজনিত পোষা পাখি নয়। বন্য থেকে ধরা পাখি এড়ান ও বৈধ উৎস দেখুন।')}</p><h2>{t(lang,'Names you may encounter','যে নামগুলো শোনা যায়')}</h2><ul><li>{t(lang,'Rose-ringed / Indian Ringneck Parakeet — Psittacula krameri. Ringneck is a species name; blue and lutino are colour descriptions, not new species.','রোজ-রিংড বা ইন্ডিয়ান রিংনেক — Psittacula krameri। রিংনেক একটি প্রজাতি; ব্লু ও লুটিনো রঙের বর্ণনা, নতুন প্রজাতি নয়।')}</li><li>{t(lang,'Alexandrine Parakeet — Psittacula eupatria. Distinct from the rose-ringed parakeet; a seller’s generic “tota” label is not sufficient identification.','চন্দনা বা আলেকজান্ড্রিন — Psittacula eupatria। রোজ-রিংড থেকে আলাদা; বিক্রেতার সাধারণ “টিয়া” নাম সঠিক পরিচয়ের জন্য যথেষ্ট নয়।')}</li><li>{t(lang,'Plum-headed Parakeet — Psittacula cyanocephala. Not a colour mutation of a ringneck.','প্লাম-হেডেড প্যারাকিট — Psittacula cyanocephala। রিংনেকের রঙের মিউটেশন নয়।')}</li><li>{t(lang,'Munias and native doves: market names can cover several species. They are not interchangeable with domestic society finches or Australian diamond doves.','মুনিয়া ও দেশীয় ঘুঘু: বাজারি নামে একাধিক প্রজাতি বোঝাতে পারে। এগুলো গৃহপালিত সোসাইটি ফিঞ্চ বা অস্ট্রেলীয় ডায়মন্ড ডাভের সমার্থক নয়।')}</li></ul><h2>{t(lang,'Enjoy without acquiring','সংগ্রহ না করেও জানুন')}</h2><p>{t(lang,'Observe at a respectful distance, avoid nest disturbance and keep domestic pets from wildlife. If a bird appears injured, seek qualified wildlife assistance rather than treating it as a new pet. Do not capture or acquire wild birds simply because they are offered for sale.','সম্মানজনক দূরত্বে দেখুন, বাসায় বিরক্তি এড়ান ও পোষা প্রাণীকে বন্য পাখি থেকে দূরে রাখুন। আহত মনে হলে নতুন পোষা পাখি না ভেবে যোগ্য বন্যপ্রাণী সহায়তা নিন। বাজারে বিক্রি হচ্ছে বলে বন্য পাখি ধরা বা সংগ্রহ করবেন না।')}</p></section></Layout>
