---
import Layout from '../../layouts/Layout.astro';import {t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,"Wild birds & conservation","বন্য পাখি ও সংরক্ষণ")} path="wildlife/"><section class="page-intro"><h1>{t(lang,"Wild birds & conservation","বন্য পাখি ও সংরক্ষণ")}</h1></section><section class="section prose"><p>{t(lang,"Native and migratory birds belong to a separate conservation context, not a pet-shopping category. Do not take a wild bird or assume that a seller establishes lawful provenance. Current Bangladesh legislation, including the requested 2026 law, could not be retrieved or verified. No claim about its enactment, provisions or species permissions is made here. Check official law and competent wildlife authorities before any acquisition, transport, breeding or trade. CITES status does not by itself establish domestic permission. No wild species care profiles are published in this edition.","দেশীয় ও পরিযায়ী পাখির বিষয়টি সংরক্ষণের, পোষা পাখি কেনার শ্রেণি নয়। বন্য পাখি ধরবেন না এবং বিক্রেতা আছে বলেই বৈধ উৎস নিশ্চিত ধরে নেবেন না। অনুরোধে উল্লেখিত ২০২৬ সালের আইনসহ বর্তমান বাংলাদেশের আইন সংগ্রহ ও যাচাই করা যায়নি। এর প্রণয়ন, বিধান বা প্রজাতির অনুমতি নিয়ে এখানে দাবি করা হচ্ছে না। সংগ্রহ, পরিবহন, প্রজনন বা বাণিজ্যের আগে সরকারি আইন ও সংশ্লিষ্ট বন্যপ্রাণী কর্তৃপক্ষের কাছে যাচাই করুন। CITES অবস্থা একা দেশীয় অনুমতি প্রমাণ করে না। এই সংস্করণে বন্য প্রজাতির বন্দী পরিচর্যা প্রকাশ করা হয়নি।")}</p><p><a href="https://github.com/tanzilamd/pakhiatlas">GitHub — tanzilamd/pakhiatlas ↗</a></p></section></Layout>
