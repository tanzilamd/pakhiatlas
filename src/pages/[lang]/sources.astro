---
import Layout from '../../layouts/Layout.astro';import PhotoCredit from '../../components/PhotoCredit.astro';import {references} from '../../data/references';import {photos} from '../../data/media';import birds from '../../data/birds.json';import wildlife from '../../data/wildlife.json';import {url,t,type Lang} from '../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;const species=[...birds,...wildlife];
---
<Layout lang={lang} title={t(lang,'Sources & acknowledgements','তথ্যসূত্র ও কৃতজ্ঞতা')} path="sources/"><section class="page-intro"><h1>{t(lang,'The sources behind PakhiAtlas.','যাঁদের কাজ থেকে আমরা শিখি।')}</h1><p>{t(lang,'Research references, photography credits and reuse terms are collected here so care articles remain easy to read. Health information supports observation and informed conversations with an avian veterinarian; it does not replace an examination.','লেখার তথ্যসূত্র, ছবির আলোকচিত্রী ও ব্যবহারবিধি এখানে একসঙ্গে রাখা হয়েছে। স্বাস্থ্যবিষয়ক লেখা পাখিকে পর্যবেক্ষণ ও চিকিৎসকের সঙ্গে আলোচনা করতে সাহায্য করে; সরাসরি পরীক্ষার বিকল্প নয়।')}</p></section><section class="section prose"><h2>{t(lang,'Care, nutrition and health','যত্ন, খাবার ও স্বাস্থ্য')}</h2><ul>{Object.entries(references).filter(([key])=>!['law','cites','taxonomy','ornithodex','trgcatalog','parrotphotos','budgieprices','ownerseed','verselemix','feedcomposition'].includes(key)).map(([id,r])=><li id={`source-${id}`}><a href={r.url}>{r.name}</a></li>)}</ul><h2>{t(lang,'Species identity and conservation','পাখির পরিচয় ও সংরক্ষণ')}</h2><ul>{['taxonomy','ornithodex','trgcatalog','parrotphotos','cites','law'].map(id=><li id={`source-${id}`}><a href={references[id].url}>{references[id].name}</a></li>)}</ul><p>{t(lang,'Species, colour mutation and domestic variety are recorded separately. Reported market presence does not establish lawful origin. No article claims veterinarian review unless such review is explicitly documented.','প্রজাতি, রঙের মিউটেশন ও গৃহপালিত জাত আলাদা করে লেখা হয়। বাজারে দেখা যাওয়া বৈধ উৎসের প্রমাণ নয়। নথিভুক্ত পর্যালোচনা ছাড়া কোনো লেখাকে পশুচিকিৎসক-পর্যালোচিত বলা হয় না।')}</p><h2>{t(lang,'Seed planning records','সিড মিক্সের হিসাবের নথি')}</h2><ul>{['ownerseed','verselemix','feedcomposition'].map(id=><li id={`source-${id}`}><a href={references[id].url}>{references[id].name}</a></li>)}</ul><p>{t(lang,'Owner notes supply the quantities for arithmetic, not clinical evidence. Manufacturer composition examples also do not establish complete nutrition or cross-species suitability.','ব্যক্তিগত নোটের পরিমাণ থেকে হিসাব করা হয়েছে; সেটি চিকিৎসা বা পুষ্টিমান যাচাইয়ের উৎস নয়। প্রস্তুতকারকের অনুপাতের উদাহরণও সম্পূর্ণ পুষ্টি বা অন্য প্রজাতির উপযুক্ততা প্রমাণ করে না।')}</p><h2>{t(lang,'Budget references','বাজেটের তথ্যসূত্র')}</h2><p id="source-budgieprices"><a href={references.budgieprices.url}>{references.budgieprices.name}</a></p><p>{t(lang,'The archived table is a secondary Bangladesh reference, not a current Dhaka survey. Its underlying breeder reports are not individually supplied. Prices shown on the budgie profile are per adult bird for the stated period, not guarantees or offers.','সংরক্ষিত তালিকাটি বাংলাদেশের একটি প্রকাশিত মূল্য-উদাহরণ; ঢাকার বর্তমান বাজার-জরিপ নয়। তালিকায় উল্লেখিত ব্রিডারদের প্রতিবেদন আলাদা করে দেওয়া নেই। বাজরিগারের প্রোফাইলে নির্দিষ্ট সময়কালের এক-পাখির হিসাব দেখানো হয়েছে; এটি দর বা বিক্রির প্রস্তাব নয়।')}</p><h2 id="photos">{t(lang,'Photographs and their creators','ছবি ও আলোকচিত্রী')}</h2><p>{t(lang,'The real photographs below retain their supplied creator credits and terms. Display copies have been resized; some were cropped to keep the bird in focus. Bird colours and anatomy have not been generated or repainted. Each image’s exact source and rights record is also preserved in the repository.','বাস্তব ছবিগুলোর দেওয়া আলোকচিত্রীর পরিচয় ও শর্ত নিচে রাখা হয়েছে। প্রদর্শনের জন্য আকার ছোট করা হয়েছে; কিছু ছবিতে পাখিকে স্পষ্ট রাখতে ফ্রেম ছোট করা হয়েছে। পাখির রং বা গড়ন কৃত্রিমভাবে তৈরি কিংবা বদলানো হয়নি। প্রতিটি ছবির নির্দিষ্ট উৎস ও ব্যবহারবিধির নথি GitHub-এও আছে।')}</p><div class="ack-photo-grid">{photos.map(p=><figure id={`photo-${p.id}`}><img src={url(p.srcset[0].src)} width={p.width} height={p.height} loading="lazy" alt={lang==='bn'?p.altBn:p.altEn}/><figcaption><strong>{species.find(b=>b.slug===p.species)?.[lang]}</strong><PhotoCredit photo={p} lang={lang}/></figcaption></figure>)}</div><h2>{t(lang,'Software and corrections','প্রযুক্তি ও সংশোধন')}</h2><p><a href={url('licenses/PhotoSwipe-MIT.txt')}>PhotoSwipe — MIT</a> · <a href="https://github.com/tanzilamd/pakhiatlas">PakhiAtlas — GitHub</a></p><p>{t(lang,'Articles and per-image records are plain text in the repository. Suggest corrections with the exact passage and a reliable source.','লেখা ও প্রতিটি ছবির নথি GitHub-এ সাধারণ টেক্সট ফাইলে আছে। সংশোধনের প্রস্তাব দিলে সংশ্লিষ্ট অংশ ও নির্ভরযোগ্য উৎস দিন।')}</p></section></Layout>
