---
import Layout from '../../layouts/Layout.astro';import {references} from '../../data/references';import {t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Sources & evidence limits','উৎস ও তথ্যের সীমা')} path="sources/"><section class="page-intro"><h1>{t(lang,'Trust begins with transparency.','স্বচ্ছতা থেকেই আস্থার শুরু।')}</h1><p>{t(lang,'This edition contains eight bilingual bird drafts and nine bilingual guide drafts. Zero are claimed as independently verified or veterinarian-reviewed.','এই সংস্করণে আটটি পাখির ও নয়টি গাইডের দ্বিভাষিক খসড়া রয়েছে। কোনোটিকেই স্বাধীনভাবে যাচাইকৃত বা পশুচিকিৎসক-পর্যালোচিত বলা হচ্ছে না।')}</p></section><section class="section prose"><div class="callout">{t(lang,'All research requests to external veterinary, taxonomic and legal sources were blocked by the environment network policy on 2 November 2026. These links are a verification queue, not proof that source text was reviewed. Page-specific claims still require passage-level checks.','২ নভেম্বর ২০২৬ পরিবেশের নেটওয়ার্ক নীতিতে বহিরাগত পশুচিকিৎসা, শ্রেণিবিন্যাস ও আইনি উৎস খোলার অনুরোধ বন্ধ ছিল। এই লিংকগুলো যাচাইয়ের তালিকা, উৎস পড়ার প্রমাণ নয়। প্রতিটি বক্তব্যের সঙ্গে উৎসের সংশ্লিষ্ট অংশ মিলিয়ে দেখা বাকি।')}</div><h2>{t(lang,'Reference ledger','উৎসের খাতা')}</h2><ul>{Object.values(references).map(r=><li><a href={r.url}>{r.name} ↗</a><p class="muted">{t(lang,r.status,'মূল উৎসে প্রবেশ ও বিস্তারিত যাচাই বাকি।')}</p></li>)}</ul><h2>{t(lang,'Images','ছবির উৎস')}</h2><p>{t(lang,'All artwork is original schematic SVG, labelled as illustration. No synthetic medical photographs or misidentified species photos are used. Species photography and local relevance research remain outstanding.','সব অলংকরণ মৌলিক SVG এবং চিত্র হিসেবে চিহ্নিত। কৃত্রিম রোগের ছবি বা ভুল প্রজাতির আলোকচিত্র ব্যবহার করা হয়নি। প্রজাতির ছবি ও স্থানীয় প্রাসঙ্গিকতার গবেষণা বাকি।')}</p></section></Layout>
