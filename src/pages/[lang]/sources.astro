---
import Layout from '../../layouts/Layout.astro';import {references} from '../../data/references';import {t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'References & editorial approach','তথ্যসূত্র ও সম্পাদনা নীতি')} path="sources/"><section class="page-intro"><h1>{t(lang,'Keep learning. Care thoughtfully.','জেনে রাখুন, বুঝে যত্ন নিন।')}</h1><p>{t(lang,'Use the care library alongside qualified veterinary advice. Bird names, individual history and the home environment all matter when making a decision.','পাখির পরিচয়, আগের অভ্যাস আর আপনার ঘরের পরিবেশ—যত্নের সিদ্ধান্তে সবই গুরুত্বপূর্ণ। স্বাস্থ্য নিয়ে উদ্বেগ থাকলে লেখার সঙ্গে মিল খুঁজে অপেক্ষা না করে পাখির চিকিৎসায় অভিজ্ঞ পশুচিকিৎসকের পরামর্শ নিন।')}</p></section><section class="section prose"><h2>{t(lang,'Veterinary and husbandry reading','স্বাস্থ্য ও পরিচর্যা নিয়ে আরও পড়ুন')}</h2><ul>{Object.entries(references).filter(([key])=>!['law','cites'].includes(key)).map(([,r])=><li><a href={r.url}>{r.name} →</a></li>)}</ul><h2>{t(lang,'How to use this site','এই সাইট কীভাবে কাজে লাগাবেন')}</h2><p>{t(lang,'Begin with the individual species, then follow the linked guides for feeding, housing and daily routines. General tendencies do not guarantee temperament, sound or compatibility. Health articles explain what to observe and when to seek help; they do not diagnose illness from a colour or photograph.','প্রথমে পাখির পরিচিতি পড়ুন। তারপর খাবার, বাসস্থান ও দৈনন্দিন যত্নের জন্য সংশ্লিষ্ট গাইডগুলো দেখুন। সাধারণ বৈশিষ্ট্য দিয়ে কোনো একটি পাখির স্বভাব, ডাক বা সঙ্গীর সঙ্গে মানিয়ে চলা নিশ্চিত করা যায় না। স্বাস্থ্যবিষয়ক লেখায় কী দেখবেন ও কখন সাহায্য নেবেন তা বোঝানো হয়; রং বা ছবি দেখে রোগ নির্ণয় করা হয় না।')}</p><h2>{t(lang,'Corrections and ownership','সংশোধন ও রক্ষণাবেক্ষণ')}</h2><p>{t(lang,'Content lives in the public Git repository. Send a specific correction with an authoritative reference through GitHub. Photos must retain their original creator, source and license credits.','সব লেখা GitHub-এ সংরক্ষিত। ভুল চোখে পড়লে সংশ্লিষ্ট অংশ ও নির্ভরযোগ্য তথ্যসূত্রসহ সংশোধনের প্রস্তাব দিন। ছবির মূল আলোকচিত্রী, উৎস ও লাইসেন্সের তথ্য সংরক্ষণ করা বাধ্যতামূলক।')}</p><a href="https://github.com/tanzilamd/pakhiatlas">GitHub →</a></section></Layout>
