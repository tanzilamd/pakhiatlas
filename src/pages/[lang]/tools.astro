---
import Layout from '../../layouts/Layout.astro';import birds from '../../data/birds.json';import foods from '../../data/foods.json';import {references} from '../../data/references';import {url,t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Practical tools','ব্যবহারিক সহায়িকা')} path="tools/"><section class="page-intro"><span class="eyebrow">{t(lang,'THINK IT THROUGH','ভেবেচিন্তে সিদ্ধান্ত')}</span><h1>{t(lang,'A little help with the big questions.','বড় প্রশ্নে ছোট্ট সহায়তা।')}</h1><p>{t(lang,'Research aids, not diagnoses or guarantees. The underlying content is pending source verification.','গবেষণার সহায়তা, রোগ নির্ণয় বা নিশ্চয়তা নয়। ব্যবহৃত তথ্যের মূল উৎস যাচাই বাকি।')}</p><div class="chips"><a href="#compare">{t(lang,'Compare','তুলনা')}</a><a href="#finder">{t(lang,'Bird Finder','পাখি বাছাই')}</a><a href="#food">{t(lang,'Food checker','খাবার যাচাই')}</a></div></section>
<section class="tool-section" id="compare"><h2>{t(lang,'Compare birds','পাখি তুলনা করুন')}</h2><p>{t(lang,'Select two or three. Labels describe general tendencies; they do not predict an individual bird.','দুই বা তিনটি বাছুন। সাধারণ বৈশিষ্ট্য দিয়ে কোনো পাখির নিজস্ব স্বভাব নিশ্চিত করা যায় না।')}</p><form id="compare-form"><fieldset><legend>{t(lang,'Choose birds (maximum three)','পাখি বাছুন (সর্বোচ্চ তিনটি)')}</legend><div class="checks">{birds.map(b=><label><input type="checkbox" name="bird" value={b.slug}/>{b[lang]}</label>)}</div></fieldset></form><p id="compare-status" role="status"></p><div id="comparison" class="table-scroll" tabindex="0" aria-label={t(lang,'Comparison table','তুলনার ছক')}></div></section>
<section class="tool-section" id="finder"><h2>{t(lang,'First Bird Finder','প্রথম পাখি বাছাইয়ের সহায়িকা')}</h2><p>{t(lang,'An honest readiness check. No answer is a promise of suitability.','নিজের প্রস্তুতি যাচাই করুন। কোনো উত্তর উপযুক্ততার নিশ্চয়তা নয়।')}</p><form id="finder-form" class="finder-form">{[
['experience',t(lang,'Experience','অভিজ্ঞতা'),[[ 'new',t(lang,'New to birds','নতুন')],['some',t(lang,'Have cared for birds','অভিজ্ঞতা আছে')]]],
['time',t(lang,'Daily care and interaction','দৈনিক যত্ন ও যোগাযোগ'),[['yes',t(lang,'I can plan daily care','প্রতিদিন সময় রাখব')],['no',t(lang,'Very limited or uncertain','সময় কম বা অনিশ্চিত')]]],
['space',t(lang,'Safe exercise space','নিরাপদ ব্যায়ামের জায়গা'),[['yes',t(lang,'I can provide it','ব্যবস্থা করতে পারব')],['no',t(lang,'Not yet','এখনও নেই')]]],
['noise',t(lang,'Noise tolerance','ডাক সহ্য করার ক্ষমতা'),[['low',t(lang,'Lower tolerance','কম')],['high',t(lang,'Louder calls are manageable','বেশি ডাক সামলাতে পারব')]]],
['household',t(lang,'Household hazards and other pets','ঘরের বিপদ ও অন্য পোষা প্রাণী'),[['yes',t(lang,'I can separate and secure them','আলাদা ও নিরাপদ রাখতে পারব')],['no',t(lang,'Not resolved','সমাধান হয়নি')]]],
['commitment',t(lang,'Long-term care and veterinary costs','দীর্ঘমেয়াদি যত্ন ও চিকিৎসার খরচ'),[['yes',t(lang,'I have a plan','পরিকল্পনা আছে')],['no',t(lang,'Not yet','এখনও নেই')]]]
].map(([name,label,options])=><label>{label as string}<select name={name as string}>{(options as string[][]).map(([value,text])=><option value={value}>{text}</option>)}</select></label>)}<button class="button">{t(lang,'See research suggestions','পড়ার পরামর্শ দেখুন')} →</button></form><div id="finder-result" role="status" class="callout"></div></section>
<section class="tool-section" id="food"><h2>{t(lang,'Food Safety Checker','খাবার সম্পর্কে খোঁজ নিন')}</h2><p>{t(lang,'A small, qualified starter list. Absence from the list never means safe. Not all birds share the same diet.','শর্তসহ ছোট প্রাথমিক তালিকা। তালিকায় না থাকা মানেই নিরাপদ নয়। সব পাখির খাবার এক নয়।')}</p><label for="food-input">{t(lang,'Food name','খাবারের নাম')}</label><input type="search" id="food-input" placeholder={t(lang,'Try apple, carrot, chocolate…','আপেল, গাজর, চকলেট…')}/><p id="food-status" role="status"></p><div id="food-results" class="guide-grid">{foods.map(f=><article class="food-card" data-food={f.aliases.toLowerCase()}><span class={`badge ${f.category}`}>{t(lang,{danger:'Toxic / dangerous',conditional:'Conditional',appropriate:'Generally appropriate',avoid:'Avoid'}[f.category]!,{danger:'বিষাক্ত / বিপজ্জনক',conditional:'শর্তসাপেক্ষ',appropriate:'সাধারণভাবে উপযোগী',avoid:'এড়িয়ে চলুন'}[f.category]!)}</span><h3>{f[lang]}</h3><p>{lang==='bn'?f.noteBn:f.noteEn}</p><a href={references[f.source].url}>{references[f.source].name} ↗</a><small>{t(lang,'Reference retrieval and species-specific verification pending.','উৎস সংগ্রহ ও প্রজাতিভিত্তিক যাচাই বাকি।')}</small></article>)}</div><div id="food-unknown" hidden class="callout">{t(lang,'Insufficient reliable evidence in this list. Do not assume this food is safe; ask an avian veterinarian.','এই তালিকায় যথেষ্ট নির্ভরযোগ্য তথ্য নেই। খাবারটি নিরাপদ ধরে নেবেন না; পাখির চিকিৎসকের কাছে জানুন।')}</div></section><noscript>{t(lang,'Interactive comparison and finder require JavaScript. The food list and bird articles remain readable.','তুলনা ও বাছাইয়ের জন্য জাভাস্ক্রিপ্ট দরকার। খাবারের তালিকা ও পাখির লেখা পড়া যাবে।')}</noscript></Layout>
<script define:vars={{birds,lang,base:url('')}}>
const bn=lang==='bn';const tr=(en,b)=>bn?b:en;const name=b=>b[lang];const link=b=>`${base}${lang}/birds/${b.slug}/`;
const form=document.querySelector('#compare-form');function compare(){const selected=[...form.querySelectorAll('input:checked')];form.querySelectorAll('input').forEach(i=>i.disabled=selected.length>=3&&!i.checked);document.querySelector('#compare-status').textContent=selected.length<2?tr('Choose at least two birds.','অন্তত দুটি পাখি বাছুন।'):tr('General tendencies only. Local availability is unverified.','শুধু সাধারণ বৈশিষ্ট্য। স্থানীয় প্রাপ্যতা যাচাই হয়নি।');const result=document.querySelector('#comparison');result.replaceChildren();if(selected.length<2)return;const chosen=selected.map(i=>birds.find(b=>b.slug===i.value));const table=document.createElement('table');const head=document.createElement('tr');head.append(document.createElement('th'));chosen.forEach(b=>{const th=document.createElement('th');th.scope='col';const a=document.createElement('a');a.href=link(b);a.textContent=name(b);th.append(a);head.append(th)});const thead=document.createElement('thead');thead.append(head);table.append(thead);const body=document.createElement('tbody');const translations={small:'ছোট',medium:'মাঝারি',large:'বড়',low:'কম',moderate:'মাঝারি',high:'বেশি',beginner:'নতুন',intermediate:'কিছু অভিজ্ঞতা',experienced:'অভিজ্ঞ'};for(const [label,key] of [[tr('Scientific name','বৈজ্ঞানিক নাম'),'scientificName'],[tr('Size class','আকার'),'size'],[tr('Typical sound','ডাক'),'noise'],[tr('Care experience','অভিজ্ঞতা'),'experience']]){const row=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=label;row.append(th);chosen.forEach(b=>{const td=document.createElement('td');td.textContent=bn?(translations[b[key]]||b[key]):b[key];row.append(td)});body.append(row)}for(const [label,value] of [[tr('Longevity','আয়ু'),tr('Numeric range withheld pending verification','উৎস যাচাই না হওয়ায় নির্দিষ্ট আয়ু নেই')],[tr('Social needs','সামাজিক চাহিদা'),tr('Daily observation, enrichment and appropriate social contact','দৈনিক পর্যবেক্ষণ, ব্যস্ততা ও উপযুক্ত সামাজিক যোগাযোগ')]]){const row=document.createElement('tr');const th=document.createElement('th');th.textContent=label;row.append(th);chosen.forEach(()=>{const td=document.createElement('td');td.textContent=value;row.append(td)});body.append(row)}table.append(body);result.append(table)}form.addEventListener('change',compare);compare();
document.querySelector('#finder-form').addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.target);const result=document.querySelector('#finder-result');result.replaceChildren();const p=document.createElement('p');const ready=['time','space','household','commitment'].every(k=>f.get(k)==='yes');p.textContent=ready?tr('Start by researching these birds. Review daily demands and arrange veterinary access before acquiring any bird.','এই পাখিগুলো সম্পর্কে পড়ে শুরু করুন। পাখি আনার আগে দৈনিক চাহিদা ও চিকিৎসার ব্যবস্থা যাচাই করুন।'):tr('Prepare the household first. Time, safe space, household safety and lifetime care are essential; postponing acquisition is a responsible choice.','আগে ঘরের প্রস্তুতি নিন। সময়, নিরাপদ জায়গা, পরিবারের নিরাপত্তা ও সারা জীবনের যত্ন জরুরি; আপাতত পাখি না আনাও দায়িত্বশীল সিদ্ধান্ত।');result.append(p);if(ready){const suggested=f.get('noise')==='low'?birds.filter(b=>b.slug==='zebra-finch'):birds.filter(b=>['budgerigar','cockatiel'].includes(b.slug));suggested.forEach(b=>{const p=document.createElement('p');const a=document.createElement('a');a.href=link(b);a.textContent=name(b)+' →';p.append(a);const why=document.createElement('span');why.textContent=tr(' — Introductory research, not a guarantee of a quiet, tame or suitable pet.',' — প্রাথমিক গবেষণা; শান্ত, পোষমানা বা উপযুক্ত হওয়ার নিশ্চয়তা নয়।');p.append(why);result.append(p)})}});
const food=document.querySelector('#food-input');food.addEventListener('input',()=>{const q=food.value.trim().toLowerCase();let n=0;document.querySelectorAll('[data-food]').forEach(el=>{el.hidden=!el.dataset.food.includes(q);if(!el.hidden)n++});document.querySelector('#food-status').textContent=tr(`${n} entries`,`${n}টি খাবার`);document.querySelector('#food-unknown').hidden=n>0});
</script>
