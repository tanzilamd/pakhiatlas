---
import Layout from '../../layouts/Layout.astro';import CompareBirds from '../../components/CompareBirds.astro';import BirdFinder from '../../components/BirdFinder.astro';import FoodChecker from '../../components/FoodChecker.astro';import BirdBudget from '../../components/BirdBudget.astro';import {t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Choose and care with confidence','বেছে নিন, যত্নের পরিকল্পনা করুন')} path="tools/"><section class="page-intro"><span class="eyebrow">{t(lang,'FROM RESEARCH TO EVERYDAY CARE','জানা থেকে প্রতিদিনের যত্ন')}</span><h1>{t(lang,'Make the choice fit your life.','আপনার জীবনের সঙ্গে মিলিয়ে বাছুন।')}</h1><p>{t(lang,'Begin with your household, compare the differences, then plan food and costs.','আগে নিজের ঘরের প্রস্তুতি দেখুন, তারপর পাখির চাহিদার পার্থক্য মিলিয়ে খাবার ও খরচের পরিকল্পনা করুন।')}</p><div class="tool-navigation">{[['compare',t(lang,'Compare birds','পাখির তুলনা')],['finder',t(lang,'First bird finder','প্রথম পাখি বাছাই')],['food',t(lang,'Food checker','খাবার যাচাই')],['budget',t(lang,'Dhaka budget','ঢাকার বাজেট')]].map(([id,label])=><a href={`#${id}`}>{label} →</a>)}</div></section><CompareBirds lang={lang}/><BirdFinder lang={lang}/><FoodChecker lang={lang}/><BirdBudget lang={lang}/></Layout>

<script>
const ids=['compare','finder','food','budget'];
function showTool(){const requested=location.hash.slice(1);const active=ids.includes(requested)?requested:'compare';for(const id of ids)document.getElementById(id)!.hidden=id!==active;document.querySelectorAll<HTMLAnchorElement>('.tool-navigation a').forEach(a=>{if(a.hash==='#'+active)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})}
document.querySelectorAll<HTMLAnchorElement>('.tool-navigation a').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();history.replaceState(null,'',a.hash);showTool()}));window.addEventListener('hashchange',showTool);showTool();
</script>
