---
import Layout from '../../layouts/Layout.astro';import photos from '../../data/photos.json';import {url,t,type Lang} from '../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Photographs & credits','ছবি ও আলোকচিত্রীর পরিচয়')} path="media/"><section class="page-intro"><h1>{t(lang,'The people behind the photographs.','ছবির পেছনের মানুষগুলো।')}</h1><p>{t(lang,'Each photograph retains its original creator and license. Optimized local copies are used throughout the site; the bird content has not been generated or replaced.','প্রতিটি ছবির মূল আলোকচিত্রী ও লাইসেন্সের পরিচয় রাখা হয়েছে। সাইটে দ্রুত দেখানোর জন্য স্থানীয় কপির আকার ও ফরম্যাট বদলানো হয়েছে; পাখির ছবি কৃত্রিমভাবে তৈরি বা বদলানো হয়নি।')}</p></section><section class="section guide-grid">{photos.map(p=><article class="guide-card"><img src={url(p.src)} width={p.width} height={p.height} loading="lazy" alt={lang==='bn'?p.altBn:p.altEn}/><p>{lang==='bn'?p.altBn:p.altEn}</p><strong>{p.creator}</strong><a href={p.sourceUrl}>{t(lang,'Original source','মূল উৎস')} →</a><a href={p.licenseUrl}>{p.license}</a>{'localLicense' in p&&p.localLicense&&<a href={url(p.localLicense)}>{t(lang,'Full license text','লাইসেন্সের পূর্ণ লেখা')}</a>}{'originalCopy' in p&&p.originalCopy&&<a class="media-original" href={url(p.originalCopy)}>{t(lang,'Received original photograph','সংগৃহীত মূল ছবি')}</a>}<small class="muted">{t(lang,'Changed: resized and converted to WebP.','পরিবর্তন: আকার ছোট করা ও WebP-তে রূপান্তর।')}</small></article>)}</section></Layout>
