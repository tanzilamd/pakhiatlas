---
import Layout from '../../layouts/Layout.astro';import {url,t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;const target=url(`${lang}/sources/#photos`);
---
<Layout lang={lang} title={t(lang,'Photo acknowledgements','ছবির কৃতজ্ঞতা')} path="media/" noindex><meta http-equiv="refresh" content={`0;url=${target}`}/><section class="page-intro"><h1>{t(lang,'Sources & acknowledgements','তথ্যসূত্র ও কৃতজ্ঞতা')}</h1><a href={target}>{t(lang,'See all credits','সব কৃতজ্ঞতা দেখুন')} →</a></section></Layout>
