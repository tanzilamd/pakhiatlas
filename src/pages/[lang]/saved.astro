---
import Layout from '../../layouts/Layout.astro';import {getCollection} from 'astro:content';import {url,t,type Lang} from '../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
const entries=(await Promise.all((['birds','guides','wildlife'] as const).map(async collection=>(await getCollection(collection)).filter(e=>e.data.language===lang).map(e=>({collection,slug:e.data.slug,title:e.data.title,summary:e.data.summary,href:url(`${lang}/${collection}/${e.data.slug}/`)}))))).flat();
---
<Layout lang={lang} title={t(lang,'Your reading list','আপনার পড়ার তালিকা')} path="saved/"><section class="page-intro"><span class="eyebrow">{t(lang,'COME BACK TO A GOOD READ','অবসরে আবার পড়ুন')}</span><h1>{t(lang,'Saved for later.','পরে পড়ার জন্য।')}</h1><p>{t(lang,'Articles saved in this browser appear here. They stay on this device; clearing browser storage removes the list. No account is needed.','এই ব্রাউজারে রেখে দেওয়া লেখাগুলো এখানে পাবেন। তালিকাটি এই ডিভাইসেই থাকে; ব্রাউজারের সংরক্ষিত তথ্য মুছে দিলে এটিও মুছে যাবে। কোনো অ্যাকাউন্ট লাগে না।')}</p></section><section class="section"><p id="saved-status" role="status"></p><div class="guide-grid" id="saved-list"></div><p id="saved-empty">{t(lang,'Use “Save for later” on an article to build your reading list.','কোনো লেখায় “পরে পড়ব” চাপলে সেটি এই তালিকায় যোগ হবে।')}</p><noscript>{t(lang,'Enable JavaScript to read this browser’s saved list.','ব্রাউজারের তালিকা দেখতে জাভাস্ক্রিপ্ট চালু থাকতে হবে।')}</noscript><a class="text-link" href={url(`${lang}/guides/`)}>{t(lang,'Browse the care library','যত্নের গাইড দেখুন')} →</a></section></Layout>
<script id="saved-data" type="application/json" set:html={JSON.stringify({entries,lang}).replace(/</g,'\\u003c')}></script>
<script>
import {readBookmarks,writeBookmarks,identity} from '../../lib/bookmarks';
type Entry={collection:'birds'|'guides'|'wildlife';slug:string;title:string;summary:string;href:string};
const state=JSON.parse(document.querySelector('#saved-data')!.textContent!) as {entries:Entry[];lang:string};
function start(){const entries=state.entries;if(!entries)return;const bn=state.lang==='bn';const list=document.querySelector('#saved-list')!;
function render(){list.replaceChildren();const saved=readBookmarks();const selected=entries.filter(e=>saved.some(b=>identity(b)===identity(e)));document.querySelector<HTMLElement>('#saved-empty')!.hidden=selected.length>0;document.querySelector('#saved-status')!.textContent=bn?`${selected.length}টি লেখা রাখা আছে`:`${selected.length} saved articles`;selected.forEach(e=>{const card=document.createElement('article');card.className='guide-card';const h=document.createElement('h2');const a=document.createElement('a');a.href=e.href;a.textContent=e.title;h.append(a);const p=document.createElement('p');p.textContent=e.summary;const remove=document.createElement('button');remove.textContent=bn?'তালিকা থেকে সরান':'Remove from list';remove.setAttribute('aria-label',(bn?'সরান: ':'Remove: ')+e.title);remove.addEventListener('click',()=>{if(writeBookmarks(readBookmarks().filter(b=>identity(b)!==identity(e))))render();else document.querySelector('#saved-status')!.textContent=bn?'ব্রাউজারে সংরক্ষণ বন্ধ আছে':'Browser storage is unavailable'});card.append(h,p,remove);list.append(card)})}render();window.addEventListener('storage',render)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
</script>
