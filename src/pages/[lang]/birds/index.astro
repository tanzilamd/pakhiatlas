---
import Layout from '../../../layouts/Layout.astro';
import BirdCard from '../../../components/BirdCard.astro';
import birds from '../../../data/birds.json';
import {t,type Lang} from '../../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Bird encyclopedia','পাখির বিশ্বকোষ')} path="birds/"><section class="page-intro"><span class="eyebrow">PAKHIATLAS / {t(lang,'ENCYCLOPEDIA','বিশ্বকোষ')}</span><h1>{t(lang,'A world of birds.','পাখির এক পৃথিবী।')}</h1><p>{t(lang,'Eight introductory research drafts. Local availability and lawful provenance must be independently checked.','আটটি প্রাথমিক গবেষণা খসড়া। স্থানীয় প্রাপ্যতা ও বৈধ উৎস আলাদাভাবে যাচাই করতে হবে।')}</p></section><section class="section"><form class="filters" id="filters"><label>{t(lang,'Name or scientific name','নাম বা বৈজ্ঞানিক নাম')}<input name="name" type="search" placeholder={t(lang,'Search birds…','পাখি খুঁজুন…')}/></label><label>{t(lang,'Family','পরিবার')}<select name="family"><option value="">{t(lang,'All families','সব পরিবার')}</option><option value="Parrots">{t(lang,'Parrots','টিয়া')}</option><option value="Finches">{t(lang,'Finches','ফিঞ্চ')}</option></select></label><label>{t(lang,'Size','আকার')}<select name="size"><option value="">{t(lang,'All sizes','সব আকার')}</option><option value="small">{t(lang,'Small','ছোট')}</option><option value="medium">{t(lang,'Medium','মাঝারি')}</option><option value="large">{t(lang,'Large','বড়')}</option></select></label><button type="reset">{t(lang,'Reset','মুছুন')}</button></form><p id="count" role="status" data-label={t(lang,'birds shown','টি পাখি দেখা যাচ্ছে')}>{birds.length} {t(lang,'birds shown','টি পাখি দেখা যাচ্ছে')}</p><div class="bird-grid">{birds.map((bird,index)=><div data-bird data-name={`${bird.en} ${bird.bn} ${bird.scientificName} ${bird.aliases}`.toLowerCase()} data-family={bird.family} data-size={bird.size}><BirdCard bird={bird} index={index} lang={lang}/></div>)}</div><p id="empty" hidden>{t(lang,'No matching birds. Try fewer filters or another spelling.','পাখি পাওয়া যায়নি। ফিল্টার কমান বা অন্য বানানে খুঁজুন।')}</p><noscript>{t(lang,'All birds are shown. Filtering needs JavaScript.','সব পাখি দেখানো হচ্ছে। ফিল্টারের জন্য জাভাস্ক্রিপ্ট দরকার।')}</noscript></section></Layout>
<script>
const form=document.querySelector<HTMLFormElement>('#filters')!;function filter(){const f=new FormData(form);let n=0;document.querySelectorAll<HTMLElement>('[data-bird]').forEach(el=>{const visible=el.dataset.name!.includes(String(f.get('name')||'').trim().toLowerCase())&&(!f.get('family')||el.dataset.family===f.get('family'))&&(!f.get('size')||el.dataset.size===f.get('size'));el.hidden=!visible;if(visible)n++});const c=document.querySelector('#count')!;c.textContent=`${n} ${c.getAttribute('data-label')}`;document.querySelector<HTMLElement>('#empty')!.hidden=n!==0}form.addEventListener('input',filter);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(filter,0));
</script>
