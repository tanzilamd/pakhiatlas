---
import Layout from '../../../layouts/Layout.astro';import BirdCard from '../../../components/BirdCard.astro';import companion from '../../../data/birds.json';import wildlife from '../../../data/wildlife.json';import care from '../../../data/care-traits.json';import {t,type Lang} from '../../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
const priority=['budgerigar','cockatiel','peach-faced-lovebird','green-cheeked-conure','fischers-lovebird','masked-lovebird','sun-conure','jenday-conure','nanday-conure'];
const rank=(slug:string)=>{const i=priority.indexOf(slug);return i<0?100:i};const birds=[...companion,...wildlife].sort((a,b)=>rank(a.slug)-rank(b.slug));
const groupOf=(b:(typeof birds)[number])=>wildlife.some(w=>w.slug===b.slug)?'native':b.slug==='budgerigar'?'budgies':b.slug==='cockatiel'?'cockatiels':b.slug.includes('lovebird')?'lovebirds':b.slug.includes('conure')?'conures':b.family==='Parrots'?'other-parrots':b.family==='Finches'?'finches':b.family==='Doves'?'doves':'quail';
const groups=[['','All groups','সব ধরন'],['budgies','Budgies','বাজরিগার'],['cockatiels','Cockatiels','ককাটেল'],['lovebirds','Lovebirds','লাভবার্ড'],['conures','Conures','কনিউর'],['finches','Finches & canaries','ফিঞ্চ ও ক্যানারি'],['doves','Pigeons & doves','কবুতর ও ঘুঘু'],['quail','Quail','কোয়েল'],['other-parrots','Other parrots','অন্যান্য প্যারট'],['native','Native & wild birds','দেশীয় ও বন্য পাখি']];
---
<Layout lang={lang} title={t(lang,'Bird encyclopedia','পাখির বিশ্বকোষ')} path="birds/"><section class="page-intro"><span class="eyebrow">PAKHIATLAS / {t(lang,'ENCYCLOPEDIA','বিশ্বকোষ')}</span><h1>{t(lang,'Know the bird before choosing.','বাছার আগে পাখিটিকে চিনুন।')}</h1><p>{t(lang,'Start with a species or group. Match sound, space and the kind of companionship you want; colours and varieties are inside each profile.','নাম বা দল ধরে খুঁজুন। ডাক, জায়গা ও আপনি কেমন সঙ্গ চান—সেগুলো মিলিয়ে দেখুন। রং ও জাতের পরিচয় আছে প্রতিটি পাখির নিজের প্রোফাইলে।')}</p></section><section class="section bird-explorer"><div class="explorer-tabs" role="group" aria-label={t(lang,'Quick bird groups','পাখির দল')} >{groups.slice(0,5).map(([value,en,bn])=><button type="button" data-group={value} aria-pressed={value===''?'true':'false'}>{value===''?t(lang,'All birds','সব পাখি'):t(lang,en,bn)}</button>)}</div><form id="filters" class="explorer-form"><div class="filters"><label>{t(lang,'Name or scientific name','নাম বা বৈজ্ঞানিক নাম')}<input name="name" type="search" placeholder={t(lang,'Search a bird…','পাখির নাম লিখুন…')}/></label><label>{t(lang,'Bird group','পাখির ধরন')}<select name="group">{groups.map(([value,en,bn])=><option value={value}>{t(lang,en,bn)}</option>)}</select></label><label>{t(lang,'Typical sound','সাধারণ ডাক')}<select name="noise"><option value="">{t(lang,'Any sound level','সব ধরনের ডাক')}</option><option value="low">{t(lang,'Usually softer','তুলনামূলক নরম')}</option><option value="moderate">{t(lang,'Chirping / whistling','মাঝারি কিচিরমিচির / শিস')}</option><option value="high">{t(lang,'Loud / sharp calls','জোরালো / তীক্ষ্ণ ডাক')}</option></select></label><button type="reset">{t(lang,'Clear filters','ফিল্টার মুছুন')}</button></div><details class="extra-filters"><summary>{t(lang,'Size and interaction preferences','আকার ও সঙ্গের ধরন মিলিয়ে নিন')}</summary><div><label>{t(lang,'Size','আকার')}<select name="size"><option value="">{t(lang,'Any size','সব আকার')}</option>{[['small','Small','ছোট'],['medium','Medium','মাঝারি'],['large','Large','বড়']].map(([v,en,bn])=><option value={v}>{t(lang,en,bn)}</option>)}</select></label><label>{t(lang,'Type of interaction','কেমন যোগাযোগ চান')}<select name="interaction"><option value="">{t(lang,'Any style','সব ধরনের সঙ্গ')}</option><option value="train">{t(lang,'Patient interaction and training','ধীরে বন্ধুত্ব ও শেখানো')}</option><option value="observe">{t(lang,'Watching flight and behaviour','ওড়া ও আচরণ দেখা')}</option></select></label></div></details></form><p id="count" role="status" data-label={t(lang,'birds shown','টি পাখি দেখা যাচ্ছে')}>{birds.length} {t(lang,'birds shown','টি পাখি দেখা যাচ্ছে')}</p><div class="bird-grid">{birds.map(bird=>{const traits=(care.species as Record<string,{interaction:string}>)[bird.slug];return <div data-bird data-name={`${bird.en} ${bird.bn} ${bird.scientificName} ${bird.aliases}`.normalize('NFC').toLowerCase()} data-bird-group={groupOf(bird)} data-size={bird.size} data-noise={bird.noise} data-interaction={traits&&traits.interaction!=='observe'?'train':'observe'}><BirdCard bird={bird} lang={lang}/></div>})}</div><p id="empty" hidden>{t(lang,'No matches. Clear a filter or try another name.','পাখি পাওয়া যায়নি। একটি ফিল্টার সরান বা অন্য নামে খুঁজুন।')}</p><p class="muted explorer-note">{t(lang,'Sound and behaviour vary by individual. Softer calls do not mean silence. Wildlife profiles explain identification and conservation.','ডাক ও স্বভাব পাখিভেদে বদলায়। নরম ডাক মানে নীরব নয়। বন্য পাখির প্রোফাইল পরিচিতি ও সংরক্ষণের জন্য।')}</p></section></Layout>
<script>
const form=document.querySelector<HTMLFormElement>('#filters')!;const group=form.elements.namedItem('group') as HTMLSelectElement;const buttons=document.querySelectorAll<HTMLButtonElement>('button[data-group]');
function filter(){const values=new FormData(form);const q=String(values.get('name')||'').normalize('NFC').trim().toLowerCase();let count=0;for(const el of document.querySelectorAll<HTMLElement>('[data-bird]')){const matches=el.dataset.name!.includes(q)&&['group','size','noise','interaction'].every(key=>!values.get(key)||(key==='group'?el.dataset.birdGroup:el.dataset[key])===values.get(key));el.hidden=!matches;if(matches)count++}for(const button of buttons)button.setAttribute('aria-pressed',String(button.dataset.group===group.value));const status=document.querySelector('#count')!;status.textContent=`${count} ${status.getAttribute('data-label')}`;document.querySelector<HTMLElement>('#empty')!.hidden=count>0}
for(const button of buttons)button.addEventListener('click',()=>{group.value=button.dataset.group!;filter()});form.addEventListener('input',filter);form.addEventListener('change',filter);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(filter,0));filter();
</script>
