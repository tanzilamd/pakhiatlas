---
import Layout from '../../../layouts/Layout.astro';
import BirdCard from '../../../components/BirdCard.astro';
import companionBirds from '../../../data/birds.json';import wildlife from '../../../data/wildlife.json';
const priority=['budgerigar','cockatiel','green-cheeked-conure','peach-faced-lovebird','sun-conure','fischers-lovebird','masked-lovebird','jenday-conure','nanday-conure'];const birds=[...companionBirds,...wildlife].sort((a,b)=>{const rank=(slug:string)=>{const i=priority.indexOf(slug);return i<0?100:i};return rank(a.slug)-rank(b.slug)});
import {t,type Lang} from '../../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Bird encyclopedia','পাখির বিশ্বকোষ')} path="birds/"><section class="page-intro"><span class="eyebrow">PAKHIATLAS / {t(lang,'ENCYCLOPEDIA','বিশ্বকোষ')}</span><h1>{t(lang,'A world of birds.','পাখির এক পৃথিবী।')}</h1><p>{t(lang,'Every species in one place. Start with budgies, cockatiels, conures and lovebirds; colours and varieties live inside each profile.','সব পাখি এক জায়গায়। বাজরিগার, ককাটেল, কনিউর ও লাভবার্ড দিয়ে শুরু করুন। রং ও জাতের পার্থক্য পাবেন প্রতিটি পাখির নিজের প্রোফাইলে।')}</p></section><section class="section bird-explorer"><div class="explorer-tabs" role="group" aria-label={t(lang,'Bird groups','পাখির দল')}>{[['all',t(lang,'All birds','সব পাখি')],['favourites',t(lang,'Start here','আগে দেখুন')],['conures',t(lang,'Conures','কনিউর')],['lovebirds',t(lang,'Lovebirds','লাভবার্ড')],['finches',t(lang,'Finches & canaries','ফিঞ্চ ও ক্যানারি')]].map(([value,label])=><button type="button" data-group={value} aria-pressed={value==='all'?'true':'false'}>{label}</button>)}</div><form class="filters" id="filters"><label>{t(lang,'Name or scientific name','নাম বা বৈজ্ঞানিক নাম')}<input name="name" type="search" placeholder={t(lang,'Search birds…','পাখি খুঁজুন…')}/></label><label>{t(lang,'Group','ধরন')}<select name="family"><option value="">{t(lang,'All families','সব পরিবার')}</option><option value="Parrots">{t(lang,'Parrots','টিয়া')}</option><option value="Finches">{t(lang,'Finches','ফিঞ্চ')}</option><option value="Doves">{t(lang,'Pigeons & doves','কবুতর ও ঘুঘু')}</option><option value="Native">{t(lang,'Native & wild birds','দেশীয় ও বন্য পাখি')}</option><option value="Quail">{t(lang,'Quail','কোয়েল')}</option></select></label><label>{t(lang,'Size','আকার')}<select name="size"><option value="">{t(lang,'All sizes','সব আকার')}</option><option value="small">{t(lang,'Small','ছোট')}</option><option value="medium">{t(lang,'Medium','মাঝারি')}</option><option value="large">{t(lang,'Large','বড়')}</option></select></label><button type="reset">{t(lang,'Reset','মুছুন')}</button></form><p id="count" role="status" data-label={t(lang,'birds shown','টি পাখি দেখা যাচ্ছে')}>{birds.length} {t(lang,'birds shown','টি পাখি দেখা যাচ্ছে')}</p><div class="bird-grid">{birds.map((bird,index)=><div data-bird data-name={`${bird.en} ${bird.bn} ${bird.scientificName} ${bird.aliases}`.toLowerCase()} data-family={bird.family} data-size={bird.size} data-slug={bird.slug} data-group-tags={[['budgerigar','cockatiel','green-cheeked-conure','peach-faced-lovebird'].includes(bird.slug)?'favourites':'',bird.slug.includes('conure')?'conures':'',bird.slug.includes('lovebird')?'lovebirds':'',bird.family==='Finches'?'finches':''].join(' ')}><BirdCard bird={bird} index={index} lang={lang}/></div>)}</div><p id="empty" hidden>{t(lang,'No matching birds. Try fewer filters or another spelling.','পাখি পাওয়া যায়নি। ফিল্টার কমান বা অন্য বানানে খুঁজুন।')}</p><noscript>{t(lang,'All birds are shown. Filtering needs JavaScript.','সব পাখি দেখানো হচ্ছে। ফিল্টারের জন্য জাভাস্ক্রিপ্ট দরকার।')}</noscript></section></Layout>
<script>
const form=document.querySelector<HTMLFormElement>('#filters')!;let group='all';document.querySelectorAll<HTMLButtonElement>('[data-group]').forEach(button=>button.addEventListener('click',()=>{group=button.dataset.group!;document.querySelectorAll('[data-group]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter()}));function filter(){const f=new FormData(form);let n=0;document.querySelectorAll<HTMLElement>('[data-bird]').forEach(el=>{const visible=(group==='all'||el.dataset.groupTags!.split(' ').includes(group))&&el.dataset.name!.includes(String(f.get('name')||'').trim().toLowerCase())&&(!f.get('family')||el.dataset.family===f.get('family'))&&(!f.get('size')||el.dataset.size===f.get('size'));el.hidden=!visible;if(visible)n++});const c=document.querySelector('#count')!;c.textContent=`${n} ${c.getAttribute('data-label')}`;document.querySelector<HTMLElement>('#empty')!.hidden=n!==0}form.addEventListener('input',filter);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>{group='all';document.querySelectorAll<HTMLElement>('[data-group]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.group==='all')));setTimeout(filter,0)});
</script>
