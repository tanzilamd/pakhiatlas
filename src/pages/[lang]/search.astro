---
import Layout from '../../layouts/Layout.astro';import {url,t,type Lang} from '../../data/site';export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;
---
<Layout lang={lang} title={t(lang,'Search the atlas','অ্যাটলাসে খুঁজুন')} path="search/"><section class="page-intro"><span class="eyebrow">{t(lang,'A GOOD PLACE TO START','খোঁজার শুরু এখানেই')}</span><h1>{t(lang,'What would you like to know?','কী জানতে চান?')}</h1><p>{t(lang,'Search names, scientific names, care topics and aliases. Results stay in your chosen language.','নাম, বৈজ্ঞানিক নাম, যত্নের বিষয় বা প্রচলিত বানান লিখুন। ফল বেছে নেওয়া ভাষায় দেখাবে।')}</p></section><section class="section"><div id="search" data-base={url('pagefind/')} data-language={lang}></div><noscript><p>{t(lang,'Search requires JavaScript. Browse the library instead.','খুঁজতে জাভাস্ক্রিপ্ট দরকার। পাঠাগার থেকেও পড়তে পারেন।')}</p><a href={url(`${lang}/birds/`)}>{t(lang,'Birds','পাখি')}</a> · <a href={url(`${lang}/guides/`)}>{t(lang,'Guides','গাইড')}</a></noscript><p id="search-error" role="status"></p></section></Layout>
<script>
const root=document.querySelector<HTMLElement>('#search')!;const css=document.createElement('link');css.rel='stylesheet';css.href=root.dataset.base+'pagefind-ui.css';document.head.append(css);const s=document.createElement('script');s.src=root.dataset.base+'pagefind-ui.js';s.onload=()=>{const ui=new (window as any).PagefindUI({element:'#search',bundlePath:root.dataset.base,showSubResults:true,showImages:false,translations:root.dataset.language==='bn'?{placeholder:'নাম বা বিষয় লিখুন',search_label:'খুঁজুন',clear_search:'মুছুন',zero_results:'কোনো ফল পাওয়া যায়নি',many_results:'[COUNT]টি ফল',one_result:'১টি ফল',searching:'খোঁজা হচ্ছে…'}:{}});const q=new URLSearchParams(location.search).get('q');if(q)ui.triggerSearch(q)};s.onerror=()=>{document.querySelector('#search-error')!.textContent=document.documentElement.lang==='bn'?'সার্চ লোড হয়নি। পাখি ও গাইডের তালিকা ব্যবহার করুন।':'Search failed to load. Please browse birds or guides.'};document.head.append(s);
</script>
