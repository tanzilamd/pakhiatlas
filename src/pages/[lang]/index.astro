---
import Layout from '../../layouts/Layout.astro';
import BirdCard from '../../components/BirdCard.astro';
import birds from '../../data/birds.json';
import {getCollection} from 'astro:content';
import {url,t,type Lang} from '../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));
const lang=Astro.params.lang as Lang;
const guides=(await getCollection('guides')).filter(g=>g.data.language===lang);
---
<Layout lang={lang} title={t(lang,'A better life for every bird','প্রতিটি পাখির জন্য আরও ভালো জীবন')}>
<section class="hero"><div class="hero-copy"><div class="eyebrow"><span class="dot"></span> {t(lang,'KNOW THEM. UNDERSTAND THEM. CARE BETTER.','চিনুন। বুঝুন। যত্ন নিন।')}</div><h1>{t(lang,'Small wings.','ছোট্ট ডানায়,')}<br/><em>{t(lang,'A world to discover.','জানার এক পৃথিবী।')}</em></h1><p>{t(lang,'Every bird has a story. Explore the birds we share our homes with, understand their needs, and make more thoughtful choices.','প্রতিটি পাখির আছে নিজস্ব গল্প। ঘরের সঙ্গী পাখিদের চিনুন, তাদের চাহিদা বুঝুন, আর জেনে-বুঝে যত্নের সিদ্ধান্ত নিন।')}</p><form class="hero-search" action={url(`${lang}/search/`)}><label class="sr-only" for="hero-query">{t(lang,'Search birds and care','পাখি ও যত্ন খুঁজুন')}</label><span aria-hidden="true">⌕</span><input id="hero-query" name="q" placeholder={t(lang,'Try “budgie” or “bird droppings”','বাজরিগার বা বিষ্ঠা লিখে খুঁজুন')}/><button aria-label={t(lang,'Search','খুঁজুন')}>→</button></form><div class="hero-links"><a href={url(`${lang}/birds/`)}>{t(lang,'Explore the encyclopedia','সব পাখির পরিচিতি')} →</a><a href={url(`${lang}/guides/first-bird/`)}>{t(lang,'New to birds? Start here','প্রথম পাখি? শুরু করুন এখানে')} →</a></div></div><aside class="hero-reading"><span class="eyebrow">{t(lang,'BEFORE THE FIRST BIRD','পাখি আনার আগে')}</span><h2>{t(lang,'Make room for a life.','শুধু খাঁচা নয়, জীবনের জায়গা দিন।')}</h2><p>{t(lang,'Start with time, household fit and everyday care. The right choice begins before a bird comes home.','প্রতিদিনের সময়, ঘরের পরিবেশ আর যত্নের দায়িত্ব—পাখি আনার আগেই এগুলো মিলিয়ে নিন।')}</p><a href={url(`${lang}/guides/first-bird/`)}>01 · {t(lang,'Is bird keeping right for you?','পাখি পালার প্রস্তুতি আছে তো?')} →</a><a href={url(`${lang}/guides/cleaning-and-droppings/`)}>02 · {t(lang,'Droppings, odour & cleaning','বিষ্ঠা, গন্ধ ও ঘর পরিষ্কার রাখা')} →</a><a href={url(`${lang}/varieties/`)}>03 · {t(lang,'Species, colours & varieties','প্রজাতি, রং ও জাত চিনুন')} →</a></aside></section>
<section class="principles"><div><span>01</span><strong>{t(lang,'Care before acquisition','সংগ্রহের আগে যত্ন')}</strong><p>{t(lang,'Understand the commitment first.','আগে দায়িত্বের গভীরতা বুঝুন।')}</p></div><div><span>02</span><strong>{t(lang,'Evidence over assumptions','অনুমান নয়, প্রমাণ')}</strong><p>{t(lang,'Sources and uncertainty, in the open.','উৎস ও অনিশ্চয়তা, দুটোই স্পষ্ট।')}</p></div><div><span>03</span><strong>{t(lang,'Wild birds belong in the wild','বন্য পাখি প্রকৃতিতেই')}</strong><p>{t(lang,'Compassion includes conservation.','মমতার সঙ্গে থাকুক সংরক্ষণ।')}</p></div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">{t(lang,'THE ENCYCLOPEDIA','পাখির বিশ্বকোষ')}</span><h2>{t(lang,'Get to know your feathered companions','আপনার পালকওয়ালা সঙ্গীদের চিনুন')}</h2></div><a class="text-link" href={url(`${lang}/birds/`)}>{t(lang,'Explore all birds','সব পাখি দেখুন')} →</a></div><div class="bird-grid">{birds.slice(0,4).map((bird,index)=><BirdCard bird={bird} lang={lang} index={index}/>)}</div></section>
<section class="beginner-banner"><div><span class="eyebrow">{t(lang,'A THOUGHTFUL START','ভেবেচিন্তে শুরু')}</span><h2>{t(lang,'The right bird starts with the right questions.','সঠিক পাখি বাছতে আগে সঠিক প্রশ্ন।')}</h2><p>{t(lang,'Time, space, sound, and a lifetime of care. Our Bird Finder helps you think it through.','সময়, জায়গা, ডাক আর দীর্ঘদিনের যত্ন। বার্ড ফাইন্ডারে নিজের প্রস্তুতিটুকু ভেবে দেখুন।')}</p><a class="button" href={url(`${lang}/tools/#finder`)}>{t(lang,'Find your starting point','নিজের প্রস্তুতি জানুন')} →</a></div><span class="banner-mark" aria-hidden="true">→</span></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">{t(lang,'THE CARE LIBRARY','যত্নের পাঠাগার')}</span><h2>{t(lang,'Little things. Lifelong wellbeing.','ছোট ছোট যত্নে, ভালো থাকুক সারাজীবন।')}</h2></div><a class="text-link" href={url(`${lang}/guides/`)}>{t(lang,'All care guides','সব গাইড')} →</a></div><div class="guide-grid">{guides.filter(g=>['balanced-diet','safe-home','trust-training'].includes(g.data.slug)).map((g,i)=><a class="guide-card" href={url(`${lang}/guides/${g.data.slug}/`)}><span class="guide-number">0{i+1}</span><span class="eyebrow">{t(lang,'EVERYDAY CARE','প্রতিদিনের যত্ন')}</span><h3>{g.data.title}</h3><p>{g.data.summary}</p><span class="text-link">{t(lang,'Read the guide','গাইড পড়ুন')} →</span></a>)}</div></section>
<section class="health-banner"><div class="health-icon" aria-hidden="true">+</div><div><span class="eyebrow">{t(lang,'NOTICE THE SMALL CHANGES','ছোট পরিবর্তন খেয়াল করুন')}</span><h2>{t(lang,'A dropping can tell a story. Not a diagnosis.','বিষ্ঠা পরিবর্তনের ইঙ্গিত দেয়, রোগের নাম নয়।')}</h2><p>{t(lang,'Learn what to observe, what can vary, and when to seek veterinary help.','কী দেখবেন, কী কী বদলাতে পারে আর কখন চিকিৎসকের সাহায্য নেবেন জানুন।')}</p><a class="text-link" href={url(`${lang}/guides/droppings/`)}>{t(lang,'Understand bird droppings','বিষ্ঠা সম্পর্কে জানুন')} →</a></div></section>
</Layout>
