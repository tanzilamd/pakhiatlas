---
import Layout from '../../layouts/Layout.astro';import FoodChecker from '../../components/FoodChecker.astro';import {getCollection} from 'astro:content';import {url,t,type Lang} from '../../data/site';
export const getStaticPaths=()=>['bn','en'].map(lang=>({params:{lang}}));const lang=Astro.params.lang as Lang;const entries=(await getCollection('guides')).filter(g=>g.data.language===lang);const slugs=['cockatiel-feeding','seed-mix','balanced-diet'];const guides=slugs.map(slug=>entries.find(g=>g.data.slug===slug)!);
---
<Layout lang={lang} title={t(lang,'Feeding plans & food safety','খাবারের পরিকল্পনা ও নিরাপত্তা')} path="feeding/"><section class="page-intro"><span class="eyebrow">{t(lang,'FOOD & EVERYDAY CARE','খাবার ও প্রতিদিনের যত্ন')}</span><h1>{t(lang,'A feeding plan you can follow.','প্রতিদিনের খাবার, বুঝে দিন।')}</h1><p>{t(lang,'Find the daily cockatiel plan, seed-mix preparation and a food list in one place. Start with your species and keep the whole diet in view.','ককাটেলের দৈনিক পরিকল্পনা, সিড মিক্স তৈরি ও খাবার যাচাই—সব এখানে। আপনার পাখির প্রজাতি ধরে শুরু করুন। বীজ, সবজি ও অন্য উপযুক্ত খাবারের ভূমিকা বুঝে দৈনিক তালিকা সাজান।')}</p></section><section class="section feeding-guides"><div class="guide-grid">{guides.map(g=><a class="guide-card" href={url(`${lang}/guides/${g.data.slug}/`)}><h2>{g.data.title}</h2><p>{g.data.summary}</p><span class="text-link">{t(lang,'Read the full guide','বিস্তারিত পড়ুন')} →</span></a>)}</div><nav class="feeding-species" aria-label={t(lang,'Species feeding chapters','প্রজাতি অনুযায়ী খাবার')}>{[['budgerigar','Budgie','বাজরিগার'],['cockatiel','Cockatiel','ককাটেল'],['peach-faced-lovebird','Lovebird','লাভবার্ড'],['green-cheeked-conure','Conure','কনিউর']].map(([slug,en,bn])=><a href={url(`${lang}/birds/${slug}/#daily-food`)}>{t(lang,en,bn)} →</a>)}</nav></section><FoodChecker lang={lang}/></Layout>
