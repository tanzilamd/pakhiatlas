---
import '../styles/global.css';
import {url,t,type Lang} from '../data/site';
interface Props {lang:Lang; title:string; description?:string; path?:string; article?:boolean; image?:{src:string;alt:string;width:number;height:number}; noindex?:boolean}
const {lang,title,description=t(lang,'A thoughtful field guide to birds, care and responsible companionship.','পাখি, যত্ন ও দায়িত্বশীল সঙ্গের জ্ঞানভান্ডার।'),path='',article=false,image,noindex=false}=Astro.props;
const canonical=new URL(url(`${lang}/${path}`),Astro.site);
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · PakhiAtlas</title><meta name="description" content={description}/><link rel="icon" href={url('illustrations/mark.svg')} type="image/svg+xml"/><link rel="canonical" href={canonical}/>{['bn','en'].map(l=><link rel="alternate" hreflang={l} href={new URL(url(`${l}/${path}`),Astro.site)}/>)}<meta property="og:title" content={`${title} · PakhiAtlas`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>{noindex&&<meta name="robots" content="noindex"/>}{image&&<><meta property="og:image" content={new URL(url(image.src),Astro.site)}/><meta property="og:image:alt" content={image.alt}/><meta property="og:image:width" content={String(image.width)}/><meta property="og:image:height" content={String(image.height)}/></>}<meta property="og:locale" content={lang==='bn'?'bn_BD':'en_US'}/><meta property="og:type" content={article?'article':'website'}/><meta name="theme-color" content="#173e31"/>
<script is:inline>try{if(localStorage.getItem('theme')==='dark')document.documentElement.dataset.theme='dark'}catch{}</script>
</head><body><a class="skip" href="#main">{t(lang,'Skip to content','মূল লেখায় যান')}</a>
<header><a class="brand" href={url(`${lang}/`)}><img src={url('illustrations/mark.svg')} alt="" width="36" height="36"/><span>Pakhi<span class="brand-light">Atlas</span><small>{t(lang,'A LITTLE KNOWLEDGE. A BETTER LIFE.','পাখির যত্ন, জানার সবকিছু।')}</small></span></a><nav aria-label={t(lang,'Main navigation','প্রধান মেনু')}><a href={url(`${lang}/birds/`)}>{t(lang,'Birds','পাখি')}</a><a href={url(`${lang}/guides/`)}>{t(lang,'Care guides','যত্নের গাইড')}</a><a href={url(`${lang}/guides/droppings/`)}>{t(lang,'Health','স্বাস্থ্য')}</a><a href={url(`${lang}/tools/`)}>{t(lang,'Tools','সহায়িকা')}</a><a href={url(`${lang}/search/`)} aria-label={t(lang,'Search','খুঁজুন')}>⌕ <span>{t(lang,'Search','খুঁজুন')}</span></a></nav><div class="header-actions"><a class="language" href={url(`${lang==='bn'?'en':'bn'}/${path}`)} lang={lang==='bn'?'en':'bn'} data-language={lang==='bn'?'en':'bn'}>BN <span>/</span> EN</a><button id="theme" aria-label={t(lang,'Toggle dark theme','আলো-অন্ধকার থিম বদলান')} title={t(lang,'Theme','থিম')}>◐</button></div></header>

<main id="main"><slot/></main><footer><div><a class="footer-brand" href={url(`${lang}/`)}>PakhiAtlas</a><p>{t(lang,'Everything You Need to Know About Birds.','পাখির যত্ন, জানার সবকিছু।')}</p><p class="muted">{t(lang,'Knowledge, never a marketplace. Made with care for Bangladesh.','জ্ঞানভান্ডার, বিক্রির বাজার নয়। বাংলাদেশের পাখিপ্রেমীদের জন্য।')}</p></div><div><a href={url(`${lang}/about/`)}>{t(lang,'About & editorial policy','পরিচিতি ও সম্পাদনা নীতি')}</a><a href={url(`${lang}/sources/`)}>{t(lang,'References','তথ্যসূত্র')}</a><a href={url(`${lang}/wildlife/`)}>{t(lang,'Wild birds & conservation','বন্য পাখি ও সংরক্ষণ')}</a><a href={url(`${lang}/saved/`)}>{t(lang,'Your reading list','আপনার পড়ার তালিকা')}</a><a href={url(`${lang}/media/`)}>{t(lang,'Photo credits','ছবির ক্রেডিট')}</a><a href="https://github.com/tanzilamd/pakhiatlas">GitHub →</a></div><p class="footer-note">{t(lang,'Education cannot replace an examination. For urgent signs, contact a veterinarian experienced with birds. No medical prescriptions or assurances of legality.','শিক্ষামূলক লেখা সরাসরি পরীক্ষার বিকল্প নয়। জরুরি লক্ষণে পাখির চিকিৎসায় অভিজ্ঞ পশুচিকিৎসকের সঙ্গে যোগাযোগ করুন। এখানে ওষুধের ব্যবস্থাপত্র বা বৈধতার নিশ্চয়তা দেওয়া হয় না।')}</p></footer>
<script>
document.querySelector('#theme')?.addEventListener('click',()=>{const dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'light';try{localStorage.setItem('theme',dark?'dark':'light')}catch{}});
document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(a=>a.addEventListener('click',()=>{try{localStorage.setItem('language',a.dataset.language!)}catch{}}));
</script></body></html>
