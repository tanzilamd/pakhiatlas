---
import PhotoCredit from './PhotoCredit.astro';import varieties from '../data/varieties.json';import birds from '../data/birds.json';import wildlife from '../data/wildlife.json';import {photos} from '../data/media';import {url,t,type Lang} from '../data/site';
interface Props {species?:string;lang:Lang}const {species,lang}=Astro.props;const score=(v:(typeof varieties)[number])=>{const p=photos.find(p=>p.species===v.species&&p.varietyIds?.includes(v.id));return p?(p.primary?2:1):0};const entries=varieties.filter(v=>!species||v.species===species).sort((a,b)=>score(b)-score(a));
---
{entries.length>0&&<section class="variety-section" aria-labelledby="varieties"><h2 id="varieties">{t(lang,'Recognising colours & varieties','রং ও জাত চিনে নিন')}</h2><p>{t(lang,'These describe colour, plumage or domestic varieties. They do not create new species or guarantee temperament.','এগুলো রং, পালকের নকশা বা গৃহপালিত ধরনের পরিচয়। রং বদলালেই নতুন প্রজাতি হয় না; স্বভাবের নিশ্চয়তাও পাওয়া যায় না।')}</p><div class="variety-grid">{entries.map(v=>{const photo=photos.find(p=>p.species===v.species&&p.varietyIds?.includes(v.id));const bird=[...birds,...wildlife].find(b=>b.slug===v.species);const collection=wildlife.some(b=>b.slug===v.species)?'wildlife':'birds';return <article class="variety-card" id={v.id}>{photo&&<figure><a href={url(photo.src)} data-variety-photo><img src={url(photo.src)} srcset={photo.srcset.map(v=>`${url(v.src)} ${v.width}w`).join(', ')} sizes="(max-width:700px) 90vw, 360px" width={photo.width} height={photo.height} loading="lazy" alt={lang==='bn'?photo.altBn:photo.altEn}/></a><figcaption><PhotoCredit photo={photo} lang={lang}/></figcaption></figure>}<div>{!species&&bird&&<a class="variety-species" href={url(`${lang}/${collection}/${bird.slug}/`)}>{bird[lang]} →</a>}<span class="eyebrow">{lang==='bn'?v.typeBn:v.typeEn}</span><h3>{v[lang]}</h3><p>{lang==='bn'?v.noteBn:v.noteEn}</p></div></article>})}</div></section>}
