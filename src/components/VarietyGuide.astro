---
import varieties from '../data/varieties.json';
import {photosForSpecies} from '../data/media';
import {url,t,type Lang} from '../data/site';
interface Props {species?:string;lang:Lang}
const {species,lang}=Astro.props;
const entries=varieties.filter(v=>!species||v.species===species).map(v=>({variety:v,photo:photosForSpecies(v.species).find(p=>p.varietyIds?.includes(v.id))}));
const illustrated=entries.filter(e=>e.photo).sort((a,b)=>Number(Boolean(b.photo?.primary))-Number(Boolean(a.photo?.primary)));
const notes=entries.filter(e=>!e.photo);
---
{entries.length>0&&<section class="variety-section" aria-labelledby="varieties">
  <h2 id="varieties">{t(lang,'Recognising colours & varieties','রং ও জাত চিনে নিন')}</h2>
  <p>{t(lang,'These describe colour, plumage or domestic varieties. They do not create new species or guarantee temperament.','এগুলো রং, পালকের নকশা বা গৃহপালিত ধরনের পরিচয়। রং বদলালেই নতুন প্রজাতি হয় না; স্বভাবের নিশ্চয়তাও পাওয়া যায় না।')}</p>
  {illustrated.length>0&&<div class="variety-grid">{illustrated.map(({variety:v,photo:p})=>p&&<article class="variety-card" id={v.id}>
    <figure><a href={url(p.src)} data-variety-photo><img src={url(p.src)} srcset={p.srcset.map(s=>`${url(s.src)} ${s.width}w`).join(', ')} sizes="(max-width:700px) 90vw, 360px" width={p.width} height={p.height} loading="lazy" alt={lang==='bn'?p.altBn:p.altEn}/></a></figure>
    <div><span class="eyebrow">{lang==='bn'?v.typeBn:v.typeEn}</span><h3>{v[lang]}</h3><p>{lang==='bn'?v.noteBn:v.noteEn}</p></div>
  </article>)}</div>}
  {notes.length>0&&<div class="variety-notes"><h3>{t(lang,'More colour and domestic forms','আরও রং ও গৃহপালিত ধরন')}</h3>{notes.map(({variety:v})=><article id={v.id}><h4>{v[lang]}</h4><p>{lang==='bn'?v.noteBn:v.noteEn}</p></article>)}</div>}
</section>}
