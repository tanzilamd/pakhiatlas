---
import prices from '../data/prices.json';import {url,t,type Lang} from '../data/site';interface Props{species:string;lang:Lang}const {species,lang}=Astro.props;const price=prices.find(p=>p.species===species);const core=['budgerigar','cockatiel','peach-faced-lovebird','fischers-lovebird','masked-lovebird','green-cheeked-conure','sun-conure','jenday-conure'];const money=(n:number)=>new Intl.NumberFormat(lang==='bn'?'bn-BD':'en-GB').format(n);
---
{core.includes(species)&&<aside class="purchase-budget" aria-label={t(lang,'Purchase and care budget','কেনা ও যত্নের বাজেট')}>
<h2>{t(lang,'Plan the purchase budget','কেনার বাজেট কেমন হবে')}</h2>
{price&&<><p>{t(lang,'A published Bangladesh price table for 2025–2026 gives these indicative amounts per adult bird:','বাংলাদেশের জন্য প্রকাশিত ২০২৫–২০২৬ সালের একটি মূল্যতালিকায় প্রাপ্তবয়স্ক একটি পাখির আনুমানিক দাম:')}</p><dl class="price-ranges">{price.ranges.map(r=><div><dt>{r[lang]}</dt><dd>৳{money(r.min)}–{money(r.max)}</dd></div>)}</dl><p class="muted">{t(lang,'This is a secondary published range, not a current Dhaka market survey or a seller quote. Type, age and individual condition can put a bird outside it; compare fresh quotes for the exact bird before budgeting.','এটি প্রকাশিত একটি মূল্যসীমা; ঢাকার বর্তমান হাট-জরিপ বা কোনো বিক্রেতার আজকের দর নয়। ধরন, বয়স ও পাখিটির অবস্থা অনুযায়ী দাম এর বাইরে হতে পারে। কেনার আগে একই ধরনের পাখির নতুন দর মিলিয়ে নিন।')}</p></>}
<p>{t(lang,'In Dhaka, compare the same species and colour form, age, independent feeding and care history. Confirm whether a quote is for one bird or a pair. A cheap bird can still need substantial housing and veterinary spending.','ঢাকায় দর তুলনার সময় প্রজাতি ও রঙের ধরন, বয়স, নিজে খাওয়ার ক্ষমতা এবং যত্নের ইতিহাস এক করে দেখুন। দামটি একটি পাখির, নাকি জোড়ার—স্পষ্ট করে নিন। কম দামে পেলেও খাঁচা ও চিকিৎসার খরচ কমে যায় না।')}</p><a href={url(`${lang}/guides/dhaka-bird-budget/`)}>{t(lang,'What to ask, which costs to include','দর নেওয়ার প্রশ্ন ও মোট খরচের হিসাব')} →</a> · <a href={url(`${lang}/tools/#budget`)}>{t(lang,'Calculate in taka','টাকায় বাজেট করুন')} →</a>
</aside>}
