---
import photos from '../data/photos.json';
import {url,t,type Lang} from '../data/site';
interface Props {bird:any;lang:Lang;index?:number} const {bird,lang}=Astro.props;
const photo=(photos as {species:string;src:string;altBn:string;altEn:string;width:number;height:number;creator:string;license:string}[]).find(p=>p.species===bird.slug);
---
<a class="bird-card" href={url(`${lang}/birds/${bird.slug}/`)}>{photo&&<div class="bird-art"><img src={url(photo.src)} alt={lang==='bn'?photo.altBn:photo.altEn} width={photo.width} height={photo.height} loading="lazy"/><span class="card-photo-credit">{photo.creator} · {photo.license}</span></div>}<div class="card-content"><span class="eyebrow">{t(lang,({Parrots:'PARROTS & PARAKEETS',Finches:'FINCHES & CANARIES',Doves:'PIGEONS & DOVES',Quail:'QUAIL'})[bird.family as string] || bird.family,({Parrots:'টিয়া ও প্যারাকিট',Finches:'ফিঞ্চ ও ক্যানারি',Doves:'কবুতর ও ঘুঘু',Quail:'কোয়েল'})[bird.family as string] || bird.family)}</span><h3>{bird[lang]} <span>→</span></h3><p class="scientific">{bird.scientificName}</p><div class="chips"><span>{t(lang,bird.size==='small'?'Small bird':bird.size==='medium'?'Medium bird':'Large bird',bird.size==='small'?'ছোট পাখি':bird.size==='medium'?'মাঝারি পাখি':'বড় পাখি')}</span><span>{t(lang,'Care overview','যত্নের পরিচিতি')}</span></div></div></a>
