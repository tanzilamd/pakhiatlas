---
import {primaryPhoto} from '../data/media';
import {url,t,type Lang} from '../data/site';
interface Props {bird:any;lang:Lang;index?:number} const {bird,lang}=Astro.props;
const photo=primaryPhoto(bird.slug);const native=bird.kind==='wildlife';const collection=native?'wildlife':'birds';
---
<a class="bird-card" href={url(`${lang}/${collection}/${bird.slug}/`)}>{photo&&<div class="bird-art"><img src={url(photo.src)} srcset={photo.srcset.map(v=>`${url(v.src)} ${v.width}w`).join(', ')} sizes="(max-width:700px) 44vw, (max-width:1000px) 45vw, 280px" alt={lang==='bn'?photo.altBn:photo.altEn} width={photo.width} height={photo.height} loading="lazy" style={photo.objectPosition?`object-position:${photo.objectPosition}`:undefined}/></div>}<div class="card-content"><span class="eyebrow">{t(lang,({Parrots:'PARROTS & PARAKEETS',Finches:'FINCHES & CANARIES',Doves:'PIGEONS & DOVES',Quail:'QUAIL',Native:'NATIVE & WILD BIRDS'})[bird.family as string] || bird.family,({Parrots:'টিয়া ও প্যারাকিট',Finches:'ফিঞ্চ ও ক্যানারি',Doves:'কবুতর ও ঘুঘু',Quail:'কোয়েল',Native:'দেশীয় ও বন্য পাখি'})[bird.family as string] || bird.family)}</span><h3>{bird[lang]} <span>→</span></h3><p class="scientific">{bird.scientificName}</p><div class="chips"><span>{t(lang,bird.size==='small'?'Small bird':bird.size==='medium'?'Medium bird':'Large bird',bird.size==='small'?'ছোট পাখি':bird.size==='medium'?'মাঝারি পাখি':'বড় পাখি')}</span>{native&&<span>{t(lang,'Wildlife','বন্য পাখি')}</span>}</div></div></a>
