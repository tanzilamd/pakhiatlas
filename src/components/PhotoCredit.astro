---
import {url,t,type Lang} from '../data/site';import type {Photo} from '../data/media';interface Props{photo:Photo;lang:Lang}const {photo:p,lang}=Astro.props;
---
<p class="ack-credit"><strong>{p.creator}</strong><br/><a href={p.sourceUrl}>{t(lang,'Photograph source','ছবির উৎস')}</a>{p.license!=='Source credit'&&<> · <a href={p.localLicense?url(p.localLicense):p.licenseUrl}>{p.license==='Stock-source-collection'?t(lang,'Original collection terms','মূল সংগ্রহের শর্ত'):p.license}</a></>}{p.originalCopy&&<> · <a href={url(p.originalCopy)}>{t(lang,'Original file','মূল ফাইল')}</a></>}</p>
