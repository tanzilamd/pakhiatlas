---
import foods from '../data/foods.json';import {url,t,type Lang} from '../data/site';interface Props{lang:Lang}const {lang}=Astro.props;
const categories:Record<string,string>={danger:t(lang,'Do not offer: dangerous','দেবেন না: বিপজ্জনক'),conditional:t(lang,'Limit portions / prepare correctly','সীমিত পরিমাণে / প্রস্তুতি মেনে'),appropriate:t(lang,'Can be part of a suitable diet','উপযুক্ত খাবারের অংশ হতে পারে'),avoid:t(lang,'Avoid','এড়িয়ে চলুন'),evidence:t(lang,'No established benefit for this use','এই ব্যবহারের উপকার নিশ্চিত নয়')};
const groups=[['','All food groups','সব ধরনের খাবার'],['vegetables','Vegetables & greens','সবজি ও শাকপাতা'],['fruit','Fruit','ফল'],['grains','Seeds & grains','বীজ ও শস্য'],['protein','Legumes & protein foods','ডাল ও প্রোটিনের খাবার'],['other','Other ingredients & cautions','অন্যান্য উপাদান ও সতর্কতা']];
---
<section class="tool-section" id="food"><h2>{t(lang,'Understand what you offer','কোন খাবার কীভাবে দেবেন')}</h2><p>{t(lang,'All foods are listed below. Search a name, choose a food group, or filter by the precautions it needs. Preparation and species still matter.','সব খাবার নিচে দেওয়া আছে। নাম লিখে খুঁজুন, খাবারের ধরন বাছুন বা সতর্কতা অনুযায়ী মিলিয়ে নিন। পাখির প্রজাতি ও খাবার তৈরির পদ্ধতি গুরুত্বপূর্ণ।')}</p><form id="food-filters" class="food-filter-form"><label>{t(lang,'Food or ingredient','খাবার বা উপাদানের নাম')}<input type="search" id="food-input" name="query" placeholder={t(lang,'Search a food name…','খাবারের নাম লিখুন…')}/></label><label>{t(lang,'Food group','খাবারের ধরন')}<select name="group">{groups.map(([value,en,bn])=><option value={value}>{t(lang,en,bn)}</option>)}</select></label><label>{t(lang,'Precaution','সতর্কতার ধরন')}<select name="safety"><option value="">{t(lang,'All precautions','সব ধরনের সতর্কতা')}</option>{Object.entries(categories).map(([value,label])=><option value={value}>{label}</option>)}</select></label><button type="reset">{t(lang,'Clear','মুছুন')}</button></form><p id="food-status" role="status">{foods.length} {t(lang,'foods','টি খাবার')}</p><div id="food-results" class="guide-grid">{foods.map(f=><article class="food-card" data-food={`${f.aliases} ${f.bn} ${f.en}`.normalize('NFC').toLowerCase()} data-food-group={f.group} data-safety={f.category}><span class={`badge ${f.category}`}>{categories[f.category]}</span><h3>{f[lang]}</h3><p>{lang==='bn'?f.noteBn:f.noteEn}</p></article>)}</div><div id="food-unknown" hidden class="callout">{t(lang,'No matching entry. Clear a filter or try another spelling. An unlisted ingredient is not automatically safe.','মিল পাওয়া যায়নি। একটি ফিল্টার সরান বা অন্য বানানে খুঁজুন। তালিকায় না থাকা উপাদান নিরাপদ ধরে নেবেন না।')}</div><p class="tool-reading"><a href={url(`${lang}/feeding/`)}>{t(lang,'Feeding plans and preparation guides','খাবারের পরিকল্পনা ও প্রস্তুতির গাইড')} →</a></p></section>
<script>
const form=document.querySelector<HTMLFormElement>('#food-filters')!;const bn=document.documentElement.lang==='bn';
function filterFood(){const f=new FormData(form);const query=String(f.get('query')||'').normalize('NFC').trim().toLowerCase();let count=0;for(const el of document.querySelectorAll<HTMLElement>('[data-food]')){el.hidden=!el.dataset.food!.includes(query)||!!(f.get('group')&&el.dataset.foodGroup!==f.get('group'))||!!(f.get('safety')&&el.dataset.safety!==f.get('safety'));if(!el.hidden)count++}document.querySelector('#food-status')!.textContent=bn?`${count}টি খাবার দেখা যাচ্ছে`:`${count} foods shown`;document.querySelector<HTMLElement>('#food-unknown')!.hidden=count>0}
form.addEventListener('input',filterFood);form.addEventListener('change',filterFood);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(filterFood,0));filterFood();
</script>
