---
import foods from '../data/foods.json';import {references} from '../data/references';import {url,t,type Lang} from '../data/site';interface Props{lang:Lang}const {lang}=Astro.props;
const categories:Record<string,string>={danger:t(lang,'Toxic / dangerous','বিষাক্ত / বিপজ্জনক'),conditional:t(lang,'Conditional','শর্তসাপেক্ষ'),appropriate:t(lang,'Generally appropriate','সাধারণভাবে উপযোগী'),avoid:t(lang,'Avoid','এড়িয়ে চলুন'),evidence:t(lang,'Insufficient evidence for this use','এই ব্যবহারে যথেষ্ট তথ্য নেই')};
---
<section class="tool-section" id="food"><h2>{t(lang,'Check a food before offering it','খাবার দেওয়ার আগে মিলিয়ে নিন')}</h2><p>{t(lang,'Preparation and species matter. A safe ingredient is not a complete diet.','কীভাবে তৈরি করছেন এবং কোন পাখিকে দিচ্ছেন—দুটিই গুরুত্বপূর্ণ। একটি নিরাপদ উপাদান পূর্ণাঙ্গ খাবার নয়।')}</p><label for="food-input">{t(lang,'Food or ingredient','খাবার বা উপাদানের নাম')}</label><input type="search" id="food-input" placeholder={t(lang,'Apple, spinach, chickpeas, grit…','আপেল, পালং, ছোলা, গ্রিট…')}/><div class="explorer-tabs">{['পালং','ছোলা','গ্রিট','নিম'].map((bn,i)=><button type="button" data-food-query={lang==='bn'?bn:['spinach','chickpea','grit','neem'][i]}>{lang==='bn'?bn:['Spinach','Chickpeas','Grit','Neem'][i]}</button>)}</div><button type="button" id="food-show-all" aria-expanded="false" aria-controls="food-results">{t(lang,'Show the full food list','খাবারের পুরো তালিকা দেখুন')}</button><p id="food-status" role="status"></p><div id="food-results" class="guide-grid">{foods.map(f=><article class="food-card" data-food={`${f.aliases} ${f.bn} ${f.en}`.normalize('NFC').toLowerCase()}><span class={`badge ${f.category}`}>{categories[f.category]}</span><h3>{f[lang]}</h3><p>{lang==='bn'?f.noteBn:f.noteEn}</p><a href={references[f.source].url}>{references[f.source].name} →</a></article>)}</div><div id="food-unknown" hidden class="callout">{t(lang,'Do not assume an unlisted food is safe. Identify the ingredient and ask an avian veterinarian before using it.','তালিকায় না থাকা খাবার নিরাপদ ধরে নেবেন না। উপাদান চিনুন এবং দেওয়ার আগে পাখির চিকিৎসকের পরামর্শ নিন।')}</div><p class="tool-reading"><a href={url(`${lang}/guides/cockatiel-feeding/`)}>{t(lang,'Cockatiel feeding plan','ককাটেলের খাবারের পরিকল্পনা')} →</a><a href={url(`${lang}/guides/seed-mix/`)}>{t(lang,'Making and storing a seed mix','সিড মিক্স তৈরি ও সংরক্ষণ')} →</a></p></section>
<script>
const input=document.querySelector<HTMLInputElement>('#food-input')!;const bn=document.documentElement.lang==='bn';let showAll=false;const allButton=document.querySelector<HTMLButtonElement>('#food-show-all')!;allButton.addEventListener('click',()=>{showAll=!showAll;input.value='';allButton.setAttribute('aria-expanded',String(showAll));allButton.textContent=bn?(showAll?'সাধারণ খাবারগুলো দেখুন':'খাবারের পুরো তালিকা দেখুন'):(showAll?'Show common foods':'Show the full food list');filterFood()});
function filterFood(){const q=input.value.normalize('NFC').trim().toLowerCase();let count=0;document.querySelectorAll<HTMLElement>('[data-food]').forEach(el=>{el.hidden=!el.dataset.food!.includes(q)||(!q&&!showAll&&!['apple','carrot','spinach','chickpea','grit','sunflower'].some(k=>el.dataset.food!.includes(k)));if(!el.hidden)count++});document.querySelector('#food-status')!.textContent=bn?`${count}টি খাবার পাওয়া গেছে`:`${count} food entries`;document.querySelector<HTMLElement>('#food-unknown')!.hidden=count>0}
input.addEventListener('input',filterFood);document.querySelectorAll<HTMLButtonElement>('[data-food-query]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.foodQuery!;filterFood();input.focus()}));filterFood();
</script>
