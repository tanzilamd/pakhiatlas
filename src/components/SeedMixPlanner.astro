---
import records from '../data/seed-mixes.json';
import {t,type Lang} from '../data/site';
interface Props {lang:Lang}
interface Recipe {id:string;titleBn:string;titleEn:string;kind:string;originalTotalGrams:number;ingredients:{id:string;bn:string;en:string;grams:number;needsIdentity?:boolean}[]}
const {lang}=Astro.props;const recipes=records as Recipe[];const initial=recipes[0];const n=(v:number)=>new Intl.NumberFormat(lang==='bn'?'bn-BD':'en-GB',{maximumFractionDigits:2}).format(v);
---
<section class="seed-planner" id="seed-batch" aria-labelledby="seed-batch-title">
  <span class="eyebrow">{t(lang,'PLAN • WEIGH • BUDGET','অনুপাত • ওজন • খরচ')}</span>
  <h2 id="seed-batch-title">{t(lang,'Your seed-mix planner','সিড মিক্সের হিসাব')}</h2>
  <p>{t(lang,'Scale a batch, see how much your stock can make in the same ratio, then add your own prices and measured daily use.','কতটুকু বানাবেন ঠিক করুন, অথবা হাতে থাকা বীজ দিয়ে একই অনুপাতে কতটা বানানো যাবে দেখুন। নিজের কেনা দর ও দৈনিক ব্যবহারের মাপ দিলে খরচ এবং কতদিন চলবে জানা যাবে।')}</p>
  <p class="seed-scope" data-mix-scope="cockatiel-owner-note"><strong>{t(lang,'Your cockatiel ingredient note.','ককাটেলের জন্য আপনার দেওয়া তালিকা।')}</strong> {t(lang,'The calculator preserves its ratios; it does not establish nutritional balance or suitability. If included, confirm the identity of “guji til” before mixing or feeding it. Sunflower, safflower, flax and hemp are included as requested; do not assume that their seed-weight share is the diet’s fat percentage.','হিসাবটি সেই অনুপাত ধরে; পুষ্টির ভারসাম্য বা উপযুক্ততা যাচাই করে না। গুজিতিল রাখলে কোন বীজ তা নিশ্চিত করে তবেই মেশাবেন; পরিচয় না জেনে খাওয়াবেন না। আপনার নির্দেশমতো সূর্যমুখী, কুসুম, তিসি ও হেম্পও একই মিক্সে আছে। বীজের ওজনের শতকরা অংশকে খাবারের চর্বির শতকরা হার ভাববেন না।')}</p>
  <p class="seed-scope" data-mix-scope="budgie-5050" hidden><strong>{t(lang,'A published budgie seed-portion example.','বাজরিগারের বীজের অংশের প্রকাশিত উদাহরণ।')}</strong> {t(lang,'50/50 canary seed and millet is a secondary record of a manufacturer’s composition, not a complete diet or a cockatiel recipe.','৫০:৫০ ক্যানারি সিড ও মিলেট একটি প্রস্তুতকারকের মিশ্রণের অনুপাতের নথি। এটি সম্পূর্ণ খাবার বা ককাটেলের রেসিপি নয়।')}</p>
  <form id="seed-plan" novalidate>
    <div class="mix-controls">
      <label>{t(lang,'Plan','কোন তালিকা')}<select name="recipe" disabled>{recipes.map((r,i)=><option value={r.id} selected={i===0}>{lang==='bn'?r.titleBn:r.titleEn}</option>)}</select></label>
      <label>{t(lang,'Calculate from','যেভাবে হিসাব করবেন')}<select name="mode" disabled><option value="target">{t(lang,'A target batch weight','কতটুকু বানাতে চান')}</option><option value="stock">{t(lang,'The stock I have','হাতে থাকা পরিমাণ')}</option></select></label>
      <label id="mix-target-label">{t(lang,'Target batch (kg)','বানাবেন (কেজি)')}<input name="batch" type="number" value="1" min="0.01" max="100" step="any" required disabled/></label>
    </div>
    <p class="mix-selection-help">{t(lang,'Untick any ingredients to leave them out. The remaining ingredients keep their original proportions to each other; their shares in the new total are recalculated.','যে উপাদান বাদ দেবেন তার টিক সরান। বাকি উপাদানগুলোর নিজেদের মধ্যে মূল অনুপাত একই থাকবে; নতুন মোটের শতকরা অংশ আবার হিসাব হবে।')}</p><div class="mix-selection-actions"><button type="button" data-mix-select="all" disabled>{t(lang,'Include all','সব রাখুন')}</button><button type="button" data-mix-select="none" disabled>{t(lang,'Exclude all','সব বাদ দিন')}</button></div><p id="mix-selected" role="status"></p>
    {recipes.map((r,i)=><p class="mix-reference" data-mix-reference={r.id} hidden={i!==0}>{t(lang,'Original listed total','মূল তালিকার মোট')}: <strong>{n(r.originalTotalGrams/1000)} {t(lang,'kg','কেজি')}</strong>{r.kind==='owner-note'&&<> · {t(lang,'The original note puts all twelve ingredients together.','মূল নোটে ১২টি উপাদান একই মিশ্রণে আছে।')}</>}</p>)}
    <p class="muted mix-scroll-hint">{t(lang,'All ingredient weights are dry weights. Prices are taka per kg; blanks mean unknown. For a known absence of stock, enter 0.','সব ওজন শুকনো বীজের। দর প্রতি কেজিতে টাকা; ফাঁকা ঘর অজানা ধরা হয়। কোনো বীজ হাতে না থাকলে মজুতে ০ দিন।')}</p>
    <nav class="mix-jumps" aria-label={t(lang,'Calculator sections','হিসাবের অংশ')}><a href="#seed-ingredients">{t(lang,'Ingredients & prices','উপাদান ও দর')}</a><a href="#mix-results">{t(lang,'Results','হিসাবের ফল')}</a><a href="#seed-usage">{t(lang,'Duration & capacity','কতদিন চলবে')}</a></nav>
    <div class="mix-table-wrap" id="seed-ingredients"><table class="mix-table"><caption class="sr-only">{t(lang,'Original ratios, required weights, stock and entered costs','মূল অনুপাত, প্রয়োজনীয় ওজন, মজুত ও নিজের দেওয়া দর')}</caption><thead><tr><th scope="col">{t(lang,'Ingredient / original amount','উপাদান / মূল পরিমাণ')}</th><th scope="col">{t(lang,'Use (g)','লাগবে (গ্রাম)')}</th><th scope="col">{t(lang,'Have (kg)','হাতে আছে (কেজি)')}</th><th scope="col">{t(lang,'Price (৳/kg)','দর (৳/কেজি)')}</th><th scope="col">{t(lang,'Used cost (৳)','ব্যবহৃত অংশের দাম (৳)')}</th><th scope="col">{t(lang,'Short / left (g)','কম / বাকি (গ্রাম)')}</th></tr></thead><tbody>{recipes.flatMap((r,ri)=>r.ingredients.map(item=><tr data-mix-row data-recipe={r.id} data-ingredient={item.id} data-grams={item.grams} hidden={ri!==0}><th scope="row"><label class="mix-include"><input type="checkbox" name={`include:${r.id}:${item.id}`} data-include checked disabled/><span data-item-name>{lang==='bn'?item.bn:item.en}</span></label><small>{n(item.grams)} {t(lang,'g','গ্রাম')} · {t(lang,'selected share','বাছাইয়ে অংশ')}: <span data-current-share>{n(item.grams/r.originalTotalGrams*100)}%</span></small>{item.needsIdentity&&<span class="mix-identity">{t(lang,'Confirm seed identity','বীজের পরিচয় মিলিয়ে নিন')}</span>}</th><td data-label={t(lang,'Use (g)','লাগবে (গ্রাম)')} data-mix-use>{n(item.grams/initial.originalTotalGrams*1000)}</td><td data-label={t(lang,'Have (kg)','হাতে আছে (কেজি)')}><input aria-label={`${lang==='bn'?item.bn:item.en}: ${t(lang,'stock in kg','হাতে আছে, কেজি')}`} name={`stock:${r.id}:${item.id}`} data-stock type="number" min="0" max="10000" step="any" placeholder="—" disabled/></td><td data-label={t(lang,'Price (৳/kg)','দর (৳/কেজি)')}><input aria-label={`${lang==='bn'?item.bn:item.en}: ${t(lang,'taka per kg','প্রতি কেজি টাকা')}`} name={`price:${r.id}:${item.id}`} data-price type="number" min="0" max="10000000" step="any" placeholder="—" disabled/></td><td data-label={t(lang,'Used cost (৳)','ব্যবহৃত অংশের দাম (৳)')} data-mix-cost>—</td><td data-label={t(lang,'Short / left (g)','কম / বাকি (গ্রাম)')} data-mix-balance>—</td></tr>))}</tbody></table></div>
    <div id="mix-message" role="status"></div>
    <div class="mix-results" id="mix-results" aria-live="polite"><dl><div><dt>{t(lang,'Batch weight','মিশ্রণের ওজন')}</dt><dd data-result="batch">{n(1)} {t(lang,'kg','কেজি')}</dd></div><div><dt>{t(lang,'Cost of the amount used','মিশ্রণে ব্যবহৃত অংশের খরচ')}</dt><dd data-result="cost">{t(lang,'Enter prices','দর লিখুন')}</dd></div><div><dt>{t(lang,'Selected stock value','রাখা উপাদানের মজুতের মূল্য')}</dt><dd data-result="stock">—</dd></div><div><dt>{t(lang,'Extra buying cost for target','লক্ষ্য মেটাতে আরও কিনতে খরচ')}</dt><dd data-result="topup">—</dd></div></dl><p data-result="unit" class="muted"></p><p data-result="limiting" class="muted"></p></div>
    <fieldset class="mix-usage" id="seed-usage"><legend>{t(lang,'How long will it last?','কতদিন চলবে?')}</legend><p>{t(lang,'Use your measured dry allocation, including what you normally discard. This is a stock forecast, not a feeding recommendation or shelf life.','নিজের মাপা শুকনো মিশ্রণের ব্যবহার লিখুন—খোসা ও ফেলে দেওয়া অংশসহ প্রতিদিন যতটুকু তোলেন। এটি মজুত ফুরানোর হিসাব; খাওয়ানোর পরামর্শ বা সংরক্ষণের মেয়াদ নয়।')}</p><div class="mix-controls"><label>{t(lang,'Birds','পাখির সংখ্যা')}<input name="birds" type="number" value="2" min="1" max="10000" step="1" required disabled/></label><label>{t(lang,'Dry mix taken per bird/day (g)','এক পাখির জন্য দিনে তোলেন (গ্রাম)')}<input name="daily" type="number" min="0.01" max="10000" step="any" placeholder={t(lang,'Your measurement','নিজের মাপ')} disabled/></label><label>{t(lang,'Planning period (days)','কতদিনের পরিকল্পনা')}<input name="period" type="number" value="30" min="1" max="100000" step="1" required disabled/></label></div><p id="mix-coverage" role="status">{t(lang,'Enter your daily measurement to calculate duration and bird capacity.','দৈনিক ব্যবহার লিখলে কতদিন চলবে ও নির্দিষ্ট সময়ে কয়টি পাখির জন্য হবে দেখা যাবে।')}</p></fieldset>
    <div class="mix-actions"><button type="button" id="mix-save" disabled>{t(lang,'Save on this browser','এই ব্রাউজারে রাখুন')}</button><button type="button" id="mix-copy" disabled>{t(lang,'Copy shopping list','কেনার তালিকা কপি')}</button><button type="reset" disabled>{t(lang,'Clear all','সব মুছুন')}</button><span id="mix-action-status" role="status"></span></div>
  </form>
  <noscript><p>{t(lang,'The original ingredient list and a 1 kg example are shown. Interactive stock and cost calculations require JavaScript.','মূল তালিকা ও ১ কেজির উদাহরণ দেওয়া আছে। মজুত ও খরচের স্বয়ংক্রিয় হিসাবের জন্য জাভাস্ক্রিপ্ট লাগবে।')}</p></noscript>
</section>
<script>
import {planSeedMix,seedCoverage} from '../lib/seed-plan';
const candidate=document.querySelector<HTMLFormElement>('#seed-plan');
if(candidate){
 const form=candidate;
 const bn=document.documentElement.lang==='bn';const fmt=new Intl.NumberFormat(bn?'bn-BD':'en-GB',{maximumFractionDigits:2});const out=(n:number)=>fmt.format(n);const text=(en:string,bnText:string)=>bn?bnText:en;const kg=text('kg','কেজি');const g=text('g','গ্রাম');
 const choice=form.elements.namedItem('recipe') as HTMLSelectElement;const mode=form.elements.namedItem('mode') as HTMLSelectElement;const batch=form.elements.namedItem('batch') as HTMLInputElement;
 const rows=Array.from(form.querySelectorAll<HTMLTableRowElement>('[data-mix-row]'));const status=form.querySelector<HTMLElement>('#mix-message')!;const result=form.querySelector<HTMLElement>('#mix-results')!;const coverage=form.querySelector<HTMLElement>('#mix-coverage')!;const action=form.querySelector<HTMLElement>('#mix-action-status')!;
 const value=(name:string)=>Number((form.elements.namedItem(name) as HTMLInputElement).value);const read=(el:HTMLInputElement)=>el.value.trim()===''?null:Number(el.value);let lastList='';
 form.querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLButtonElement>('input,select,button').forEach(el=>el.disabled=false);
 function calculate(){
  const recipeRows=rows.filter(r=>r.dataset.recipe===choice.value);
  const active=recipeRows.filter(r=>r.querySelector<HTMLInputElement>('[data-include]')!.checked);
  const selectedBase=active.reduce((n,r)=>n+Number(r.dataset.grams),0);
  for(const r of rows){const visible=recipeRows.includes(r);const included=active.includes(r);r.hidden=!visible;r.dataset.omitted=String(!included);r.querySelector<HTMLInputElement>('[data-include]')!.disabled=!visible;r.querySelectorAll<HTMLInputElement>('[data-stock],[data-price]').forEach(el=>el.disabled=!included);r.querySelector<HTMLElement>('[data-current-share]')!.textContent=included?out(Number(r.dataset.grams)/selectedBase*100)+'%':'—';if(!included)r.querySelectorAll<HTMLElement>('[data-mix-use],[data-mix-cost],[data-mix-balance]').forEach(el=>el.textContent='—')}
  form.querySelector('#mix-selected')!.textContent=text(`${out(active.length)} ingredients selected; their original total ${out(selectedBase/1000)} ${kg}.`,`${out(active.length)}টি উপাদান রাখা হয়েছে; সেগুলোর মূল ওজন ${out(selectedBase/1000)} ${kg}।`);
  batch.disabled=mode.value==='stock';form.querySelector<HTMLElement>('#mix-target-label')!.hidden=batch.disabled;
  document.querySelectorAll<HTMLElement>('[data-mix-reference]').forEach(el=>el.hidden=el.dataset.mixReference!==choice.value);document.querySelectorAll<HTMLElement>('[data-mix-scope]').forEach(el=>el.hidden=el.dataset.mixScope!==choice.value);
  result.hidden=false;status.textContent='';lastList='';
  if(!active.length){result.hidden=true;status.textContent=text('Select at least one ingredient to calculate a mix.','হিসাব করতে অন্তত একটি উপাদান রাখুন।');coverage.textContent='—';return}
  if(!form.checkValidity()){result.hidden=true;status.textContent=text('Check the highlighted weights, counts and prices; values must be finite and non-negative.','ওজন, সংখ্যা ও দর ঠিক করুন; ঋণাত্মক বা অবৈধ মান দিয়ে হিসাব করা যাবে না।');active.forEach(r=>r.querySelectorAll<HTMLElement>('[data-mix-use],[data-mix-cost],[data-mix-balance]').forEach(el=>el.textContent='—'));coverage.textContent='—';return}
  const stockKg:Record<string,number|null>={};const priceKg:Record<string,number|null>={};for(const r of active){stockKg[r.dataset.ingredient!]=read(r.querySelector<HTMLInputElement>('[data-stock]')!);priceKg[r.dataset.ingredient!]=read(r.querySelector<HTMLInputElement>('[data-price]')!)}
  const plan=planSeedMix(active.map(r=>({id:r.dataset.ingredient!,grams:Number(r.dataset.grams)})),{mode:mode.value as 'stock'|'target',targetGrams:Number(batch.value)*1000,stockKg,priceKg});
  const set=(key:string,v:string)=>result.querySelector<HTMLElement>(`[data-result="${key}"]`)!.textContent=v;
  const lines:string[]=[choice.selectedOptions[0].textContent||''];
  for(const r of active){const d=plan.rows.find(i=>i.id===r.dataset.ingredient)!;const name=r.querySelector('[data-item-name]')!.textContent||'';r.querySelector<HTMLElement>('[data-mix-use]')!.textContent=d.required===null?'—':out(d.required);r.querySelector<HTMLElement>('[data-mix-cost]')!.textContent=d.usedCost===null?'—':out(d.usedCost);r.querySelector<HTMLElement>('[data-mix-balance]')!.textContent=d.shortfall===null?'—':d.shortfall>1e-8?`${text('Short','কম')} ${out(d.shortfall)}`:`${text('Left','বাকি')} ${out(d.leftover!)}`;if(d.required!==null)lines.push(`${name}${r.querySelector('.mix-identity')?text(' (identify first)',' (পরিচয় নিশ্চিত করুন)'):''}: ${out(d.required)} ${g}${d.shortfall!==null?` · ${text('buy','কিনতে হবে')} ${out(d.shortfall)} ${g}`:''}`)}
  set('batch',plan.batchGrams===null?'—':`${out(plan.batchGrams/1000)} ${kg}`);
  set('cost',plan.batchGrams===null?'—':!plan.pricedRows?text('Enter prices','দর লিখুন'):`৳${out(plan.usedCost)}${plan.usedPriceComplete?'':text(' (partial; some prices missing)',' (আংশিক; কিছু দর বাকি)')}`);
  const knownStock=plan.rows.some(r=>r.stockValue!==null);set('stock',knownStock?`৳${out(plan.stockValue)}${plan.stockValueComplete?'':text(' (partial)',' (আংশিক)')}`:'—');set('topup',plan.topUpComplete?`৳${out(plan.topUpCost)}`:'—');
  set('unit',plan.costPerKg===null?'':`${text('Mixed portion cost per kg','মিশ্রণের প্রতি কেজির খরচ')}: ৳${out(plan.costPerKg)}`);
  const names=plan.limiting.map(id=>active.find(r=>r.dataset.ingredient===id)!.querySelector('[data-item-name]')!.textContent?.trim());set('limiting',names.length?`${text('Stock limiting the same ratio','একই অনুপাতের মিশ্রণ সীমিত করছে')}: ${names.join(', ')}`:'');
  if(plan.batchGrams===null)status.textContent=text('Enter stock for every ingredient. Use 0 for a known absence; leave prices blank if unknown.','প্রতিটি উপাদানের মজুত লিখুন। কোনোটি না থাকলে ০ দিন; দর জানা না থাকলে ফাঁকা রাখুন।');
  const dailyEl=form.elements.namedItem('daily') as HTMLInputElement;
  if(!dailyEl.value.trim())coverage.textContent=text('Enter your measured dry allocation per bird/day to see duration and capacity.','এক পাখির জন্য দিনে যত গ্রাম শুকনো মিশ্রণ তোলেন, সেই মাপ দিলে কতদিন চলবে দেখা যাবে।');
  else if(plan.batchGrams===null)coverage.textContent=text('Complete stock quantities first.','আগে সব উপাদানের মজুত লিখুন।');
  else {const c=seedCoverage(plan.batchGrams,value('birds'),value('daily'),value('period'),plan.costPerKg);coverage.textContent=text(`At your entered use: about ${out(c.days)} days (${out(c.wholeDays)} full days); enough for ${out(c.birdsForPeriod)} birds for ${out(value('period'))} days.`,`আপনার দেওয়া ব্যবহার ধরে প্রায় ${out(c.days)} দিন (${out(c.wholeDays)}টি পূর্ণ দিন); ${out(value('period'))} দিনের জন্য ${out(c.birdsForPeriod)}টি পাখির পরিমাণ।`)+(c.dailyCost===null?'':text(` Daily flock cost ৳${out(c.dailyCost)}; period cost ৳${out(c.periodCost!)}.`,` সব পাখির দৈনিক খরচ ৳${out(c.dailyCost)}; পরিকল্পনার সময়ের খরচ ৳${out(c.periodCost!)}।`))}
  if(plan.batchGrams!==null)lastList=[...lines,`${text('Total','মোট')}: ${out(plan.batchGrams/1000)} ${kg}`,text('Planning arithmetic, not a feeding recommendation.','পরিকল্পনার হিসাব; খাওয়ানোর পরামর্শ নয়।')].join('\n');
 }
 form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',calculate);form.addEventListener('change',calculate);
 const key='pakhiatlas:seed-plan:v1';
 form.querySelectorAll<HTMLButtonElement>('[data-mix-select]').forEach(button=>button.addEventListener('click',()=>{rows.filter(r=>r.dataset.recipe===choice.value).forEach(r=>r.querySelector<HTMLInputElement>('[data-include]')!.checked=button.dataset.mixSelect==='all');calculate()}));
 form.querySelector('#mix-save')!.addEventListener('click',()=>{if(!form.checkValidity()){form.reportValidity();return}try{const saved=Object.fromEntries(new FormData(form));form.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select').forEach(el=>saved[el.name]=el instanceof HTMLInputElement&&el.type==='checkbox'?(el.checked?'1':'0'):el.value);localStorage.setItem(key,JSON.stringify(saved));action.textContent=text('Saved on this browser.','এই ব্রাউজারে রাখা হয়েছে।')}catch{action.textContent=text('Browser storage is unavailable.','ব্রাউজারে সংরক্ষণ বন্ধ আছে।')}});
 form.querySelector('#mix-copy')!.addEventListener('click',async()=>{if(!lastList){action.textContent=text('Complete a valid batch first.','আগে মিশ্রণের হিসাব সম্পূর্ণ করুন।');return}try{await navigator.clipboard.writeText(lastList);action.textContent=text('Shopping list copied.','কেনার তালিকা কপি হয়েছে।')}catch{action.textContent=lastList}});
 form.addEventListener('reset',()=>{try{localStorage.removeItem(key)}catch{}setTimeout(()=>{calculate();action.textContent=text('All inputs and saved plan cleared.','হিসাব ও রাখা নোট মুছে দেওয়া হয়েছে।')},0)});
 try{const saved=JSON.parse(localStorage.getItem(key)||'null');if(saved&&typeof saved==='object')for(const [name,v] of Object.entries(saved)){const el=form.elements.namedItem(name);if((el instanceof HTMLInputElement||el instanceof HTMLSelectElement)&&typeof v==='string'&&v.length<60){if(el instanceof HTMLInputElement&&el.type==='checkbox')el.checked=v==='1';else el.value=v}}}catch{}
 if(!Array.from(choice.options).some(o=>o.value===choice.value))choice.selectedIndex=0;if(!['target','stock'].includes(mode.value))mode.value='target';calculate();
}
</script>
