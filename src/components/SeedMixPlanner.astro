---
import mixes from '../data/seed-mixes.json';import {t,type Lang} from '../data/site';interface Props{lang:Lang}const {lang}=Astro.props;const recipe=mixes[0];const number=(n:number)=>new Intl.NumberFormat(lang==='bn'?'bn-BD':'en-GB').format(n);
---
<section class="seed-planner" id="seed-batch" aria-labelledby="seed-batch-title"><span class="eyebrow">{t(lang,'INGREDIENTS & WEIGHTS','উপাদান ও ওজন')}</span><h2 id="seed-batch-title">{lang==='bn'?recipe.titleBn:recipe.titleEn}</h2><p>{t(lang,'One published budgie seed-mix composition uses equal weights of canary seed and millet. For a 1 kg batch, that is 500 g of each. Use the batch selector to scale the same proportion.','বাজরিগারের জন্য প্রকাশিত একটি বীজমিশ্রণে সমান ওজনের ক্যানারি সিড ও মিলেট ব্যবহার করা হয়েছে। ১ কেজি বানালে প্রতিটি লাগে ৫০০ গ্রাম। নিচে ব্যাচের আকার বদলে একই অনুপাতে ওজন দেখে নিন।')}</p><label for="seed-batch-size">{t(lang,'How much dry mix will you prepare?','কতটুকু শুকনো মিশ্রণ বানাবেন?')}<select id="seed-batch-size" disabled>{[250,500,1000,2000].map(n=><option value={n} selected={n===1000}>{number(n)} {t(lang,'g','গ্রাম')}</option>)}</select></label><table><caption class="sr-only">{t(lang,'Ingredient weights for the selected batch','বাছাই করা ব্যাচের উপাদান ও ওজন')}</caption><thead><tr><th scope="col">{t(lang,'Ingredient','উপাদান')}</th><th scope="col">{t(lang,'Share by weight','ওজনে অংশ')}</th><th scope="col">{t(lang,'Amount','পরিমাণ')}</th></tr></thead><tbody>{recipe.ingredients.map(i=><tr><th scope="row">{i[lang]}</th><td>{number(i.percent)}%</td><td data-seed-percent={i.percent}>{number(1000*i.percent/100)} {t(lang,'g','গ্রাম')}</td></tr>)}</tbody><tfoot><tr><th scope="row" colspan="2">{t(lang,'Total dry batch','মোট শুকনো মিশ্রণ')}</th><td id="seed-batch-total">{number(1000)} {t(lang,'g','গ্রাম')}</td></tr></tfoot></table><p id="seed-batch-status" role="status" class="sr-only"></p><p class="seed-scope"><strong>{t(lang,'A seed portion, not the whole diet.','এটি খাবারের বীজের অংশ।')}</strong> {t(lang,'The example illustrates a manufacturer’s budgie mix composition; it is not a clinically balanced home-diet formula. It does not supply all vitamins or calcium. Do not use it as the whole diet, as a daily gram allowance, or copy it automatically for cockatiels, lovebirds or conures.','উদাহরণটি একটি প্রস্তুতকারকের বাজরিগারের মিশ্রণের অনুপাত বোঝায়; ঘরে তৈরি সম্পূর্ণ সুষম খাবারের ফর্মুলা নয়। এতে সব ভিটামিন বা পর্যাপ্ত ক্যালসিয়াম নিশ্চিত হয় না। এটিকেই পুরো খাবার, প্রতিদিনের গ্রাম-মাপ বা ককাটেল, লাভবার্ড ও কনিউরের একই রেসিপি ধরে নেবেন না।')}</p><p>{t(lang,'Canary seed means the identified grain, not a packet of mixed canary feed. Buy clean, untreated food-grade ingredients. Check the actual millet name rather than combining bags with overlapping local names; mix dry, label the date and follow the storage steps below.','ক্যানারি সিড বলতে নির্দিষ্ট বীজটি বোঝানো হয়েছে, ক্যানারি পাখির প্যাকেটজাত মিশ্র খাবার নয়। পরিষ্কার, খাবারযোগ্য ও বপনের রাসায়নিকমুক্ত বীজ নিন। চিনা, কাউন বা “মিলেট মিক্স” নামে একই বীজ বারবার যোগ হচ্ছে কি না নাম মিলিয়ে দেখুন। শুকনো অবস্থায় ওজন করে মেশান, তারিখ লিখুন এবং নিচের সংরক্ষণের ধাপ অনুসরণ করুন।')}</p></section>
<script>
const selector=document.querySelector<HTMLSelectElement>('#seed-batch-size');if(selector){selector.disabled=false;const bn=document.documentElement.lang==='bn';const format=new Intl.NumberFormat(bn?'bn-BD':'en-GB');selector.addEventListener('change',()=>{const total=Number(selector.value);if(![250,500,1000,2000].includes(total))return;const unit=bn?'গ্রাম':'g';document.querySelectorAll<HTMLElement>('[data-seed-percent]').forEach(el=>el.textContent=`${format.format(total*Number(el.dataset.seedPercent)/100)} ${unit}`);document.querySelector('#seed-batch-total')!.textContent=`${format.format(total)} ${unit}`;document.querySelector('#seed-batch-status')!.textContent=bn?`${format.format(total)} গ্রামের ব্যাচের হিসাব দেখানো হচ্ছে`:`Showing a ${format.format(total)} g batch`})}
</script>
