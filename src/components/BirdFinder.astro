---
import {url,t,type Lang} from '../data/site';interface Props{lang:Lang}const {lang}=Astro.props;
const questions=[['experience','Experience','পাখি পালার অভিজ্ঞতা',[['new','First bird','প্রথম পাখি'],['some','Have cared for birds','আগে পাখি রেখেছি']]],['goal','What would you enjoy?','কোন ধরনের সঙ্গ চান?',[['companion','Patient interaction and training','ধীরে বন্ধুত্ব ও শেখানো'],['observe','Watching flight and social behaviour','ওড়া ও দলীয় আচরণ দেখা']]],['time','Everyday care','প্রতিদিনের সময়',[['daily','Daily care, cleaning and observation are planned','খাবার, পরিষ্কার ও পর্যবেক্ষণের সময় রাখব'],['limited','Time or backup care is uncertain','সময় বা বিকল্প অভিভাবক অনিশ্চিত']]],['space','Safe exercise space','নিরাপদ চলাফেরার জায়গা',[['room','A safe room and a suitable enclosure','নিরাপদ ঘর ও উপযুক্ত খাঁচা'],['aviary','A properly designed flight aviary','পরিকল্পিত ফ্লাইট এভিয়ারি'],['none','Not arranged yet','এখনও ব্যবস্থা নেই']]],['noise','Household noise tolerance','ঘরে ডাক কতটা মানাবে?',[['low','Prefer softer calls; chirping is fine','নরম ডাক চাই; কিচিরমিচির চলবে'],['moderate','Whistling and chatter are manageable','শিস ও বকবক চলবে'],['high','Sharp contact calls are manageable','চড়া ডাকও সামলাতে পারব'],['silent','Need a silent home','নীরব ঘর দরকার']]],['dust','Feather-dust sensitivity','পালকের ধুলো নিয়ে সমস্যা আছে?',[['normal','No particular concern identified','বিশেষ সমস্যা জানা নেই'],['sensitive','Dust is a concern in the household','পরিবারে ধুলো নিয়ে সমস্যা আছে']]],['household','Safety plan','ঘরের নিরাপত্তা',[['yes','Cooking fumes, fans and other pets can be separated','রান্নার ধোঁয়া, ফ্যান ও অন্য প্রাণী আলাদা রাখব'],['no','Hazards are not resolved','বিপদগুলো এখনও সামলানো হয়নি']]],['funds','Ongoing costs','নিয়মিত খরচ',[['yes','Food, housing and veterinary access have a budget','খাবার, বাসা ও চিকিৎসার বাজেট আছে'],['no','Only the purchase price is planned','এখন শুধু কেনার খরচ ভেবেছি']]],['commitment','Long-term responsibility','দীর্ঘমেয়াদি দায়িত্ব',[['yes','Family and backup care are planned','পরিবার ও বিকল্প অভিভাবকের পরিকল্পনা আছে'],['no','Still deciding','এখনও ভেবে দেখছি']]]];
---
<section class="tool-section" id="finder"><h2>{t(lang,'Find birds worth researching','আপনার ঘরে কোন পাখি মানাতে পারে')}</h2><p>{t(lang,'Nine practical questions, then a shortlist with reasons and trade-offs. A result is a starting point for research, not a promise of compatibility.','নয়টি বাস্তব প্রশ্নের উত্তর দিন। তারপর কেন কোনো পাখি নিয়ে ভাবতে পারেন, আর কোথায় অসুবিধা হতে পারে—সেটি দেখুন। ফলাফলটি পড়াশোনার শুরু, মানিয়ে চলার নিশ্চয়তা নয়।')}</p><form id="finder-form" class="finder-form">{questions.map(([name,en,bn,options])=><label>{t(lang,en as string,bn as string)}<select name={name as string} required><option value="" selected disabled>{t(lang,'Choose an answer','উত্তর বেছে নিন')}</option>{(options as string[][]).map(([value,en,bn])=><option value={value}>{t(lang,en,bn)}</option>)}</select></label>)}<div class="finder-submit"><p id="finder-progress" class="muted" aria-live="polite"></p><button class="button">{t(lang,'Build my shortlist','আমার জন্য পাখির তালিকা দেখুন')} →</button></div></form><div id="finder-result" tabindex="-1" aria-live="polite" hidden></div><noscript><p>{t(lang,'Read the first-bird checklist and compare species profiles. The personalised shortlist needs JavaScript.','প্রথম পাখির চেকলিস্ট পড়ুন ও প্রোফাইল মিলিয়ে দেখুন। এই ব্যক্তিগত তালিকার জন্য জাভাস্ক্রিপ্ট দরকার।')}</p></noscript><a class="text-link" href={url(`${lang}/guides/first-bird/`)}>{t(lang,'First-bird checklist','প্রথম পাখির চেকলিস্ট')} →</a></section>
<script>
import {findBirds,type FinderAnswers} from '../lib/finder';import birds from '../data/birds.json';import traits from '../data/care-traits.json';import {primaryPhoto} from '../data/media';import {url} from '../data/site';
const bn=document.documentElement.lang==='bn';const lang=bn?'bn':'en';const form=document.querySelector<HTMLFormElement>('#finder-form')!;const result=document.querySelector<HTMLElement>('#finder-result')!;
const tr=(en:string,b:string)=>bn?b:en;
const progress=()=>{const count=Array.from(form.querySelectorAll('select')).filter(s=>s.value).length;document.querySelector('#finder-progress')!.textContent=tr(`${count} of 9 answered`,`${count}/৯টি উত্তর দেওয়া হয়েছে`)};form.addEventListener('change',progress);progress();
const reasons:Record<string,string>={aviary:tr('Your planned flight aviary supports this observational grass-parakeet option.','আপনার পরিকল্পিত ফ্লাইট এভিয়ারি এই শান্ত ঘাস-প্যারাকিটের চলাফেরার সুযোগ দিতে পারে।'),contact:tr('Can be researched for patient, reward-based interaction.','ধৈর্য ও পুরস্কার দিয়ে বন্ধুত্ব গড়ার জন্য পড়ে দেখতে পারেন।'),observe:tr('A better match for watching birds than expecting frequent handling.','বারবার ধরার বদলে পাখির আচরণ দেখার পছন্দের সঙ্গে বেশি মেলে।'),softer:tr('Generally softer calls than the louder parrots in this shortlist.','তালিকার বেশি জোরে ডাকা প্যারটগুলোর তুলনায় সাধারণত নরম ডাক।')};
const blockers:Record<string,string>={time:tr('Arrange daily care and a backup person first.','প্রতিদিনের যত্ন ও বিকল্প অভিভাবক ঠিক করুন।'),space:tr('Arrange safe flight or exercise space and an appropriate enclosure.','নিরাপদ ওড়া বা ব্যায়ামের জায়গা ও উপযুক্ত ঘের তৈরি করুন।'),noise:tr('No bird can be promised silent; reconsider the household requirement.','কোনো পাখিকে নীরব থাকার নিশ্চয়তা দেওয়া যায় না; ঘরের চাহিদাটি আবার ভাবুন।'),household:tr('Separate cooking fumes, open fans and predatory pets.','রান্নার ধোঁয়া, খোলা ফ্যান ও শিকার করতে পারে এমন প্রাণী আলাদা করুন।'),funds:tr('Budget for food, housing and veterinary care beyond purchase.','কেনার পাশাপাশি খাবার, বাসা ও চিকিৎসার বাজেট রাখুন।'),commitment:tr('Plan long-term care with family and a backup caregiver.','পরিবার ও বিকল্প অভিভাবক নিয়ে দীর্ঘমেয়াদি যত্নের পরিকল্পনা করুন।')};
form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const a=Object.fromEntries(new FormData(form)) as FinderAnswers;const output=findBirds(a);result.hidden=false;result.replaceChildren();const title=document.createElement('h3');title.textContent=output.blockers.length?tr('Prepare these things first','আগে এই প্রস্তুতিগুলো নিন'):tr('Your research shortlist','আপনার পড়ার ছোট তালিকা');result.append(title);if(output.blockers.length){const list=document.createElement('ul');output.blockers.forEach(k=>{const li=document.createElement('li');li.textContent=blockers[k];list.append(li)});result.append(list)}else{const grid=document.createElement('div');grid.className='finder-cards';output.recommendations.forEach(r=>{const bird=birds.find(b=>b.slug===r.slug)!;const card=document.createElement('article');card.className='finder-card';const photo=primaryPhoto(r.slug);if(photo){const img=document.createElement('img');img.src=url(photo.srcset[0].src);img.alt=bn?photo.altBn:photo.altEn;img.width=400;img.height=280;card.append(img)}const h=document.createElement('h4');const link=document.createElement('a');link.href=url(`${lang}/birds/${r.slug}/`);link.textContent=bird[lang]+' →';h.append(link);card.append(h);r.reasons.forEach(key=>{const p=document.createElement('p');p.textContent=reasons[key];card.append(p)});const caution=document.createElement('p');caution.className='finder-caution';caution.textContent=(traits.species as Record<string,{watchOut:string[]}>)[r.slug].watchOut[bn?1:0];if(a.dust==='sensitive')caution.textContent+=' '+tr('All birds produce some dust; this is not an allergy-safety recommendation.','সব পাখি থেকেই কিছু ধুলো হয়; এটি অ্যালার্জি-নিরাপত্তার সুপারিশ নয়।');card.append(caution);grid.append(card)});result.append(grid)}result.focus({preventScroll:true});result.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth',block:'start'});});
</script>
