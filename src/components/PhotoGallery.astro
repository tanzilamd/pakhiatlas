---
import photos from '../data/photos.json';
import {url,t,type Lang} from '../data/site';
interface Photo {species:string;src:string;srcset:{src:string;width:number}[];width:number;height:number;altEn:string;altBn:string;creator:string;sourceUrl:string;license:string;licenseUrl:string}
interface Props {species:string;lang:Lang}const {species,lang}=Astro.props;const images=(photos as Photo[]).filter(p=>p.species===species);
---
{images.length>0&&<section class="photo-gallery" aria-label={t(lang,'Bird photographs','পাখির ছবি')}>{images.map((p,i)=><figure><a href={url(p.src)} aria-label={t(lang,'Open full-size photograph','বড় করে ছবি দেখুন')}><img src={url(p.src)} srcset={p.srcset.map(v=>`${url(v.src)} ${v.width}w`).join(', ')} sizes="(max-width:700px) 90vw, 760px" width={p.width} height={p.height} alt={lang==='bn'?p.altBn:p.altEn} loading={i===0?'eager':'lazy'} decoding="async"/></a><figcaption><span>{lang==='bn'?p.altBn:p.altEn}</span><small>{t(lang,'Photo','ছবি')}: <a href={p.sourceUrl}>{p.creator}</a> · <a href={p.licenseUrl}>{p.license}</a></small></figcaption></figure>)}</section>}
