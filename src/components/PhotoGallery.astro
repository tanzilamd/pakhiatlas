---
import PhotoCredit from './PhotoCredit.astro';import {photosForSpecies} from '../data/media';import {url,t,type Lang} from '../data/site';
interface Props {species:string;lang:Lang}const {species,lang}=Astro.props;const images=photosForSpecies(species);
---
{images.length>0&&<><section class="photo-gallery" aria-label={t(lang,'Bird photographs','পাখির ছবি')}>{images.map((p,i)=><figure><a href={url(p.src)} data-photo-zoom aria-label={t(lang,'Open full-size photograph','বড় করে ছবি দেখুন')}><img src={url(p.src)} srcset={p.srcset.map(v=>`${url(v.src)} ${v.width}w`).join(', ')} sizes={i===0?'(max-width:700px) 90vw, 760px':'(max-width:700px) 44vw, 360px'} width={p.width} height={p.height} alt={lang==='bn'?p.altBn:p.altEn} loading={i===0?'eager':'lazy'} decoding="async"/></a><figcaption><span>{lang==='bn'?(p.captionBn||p.altBn):(p.captionEn||p.altEn)}</span><PhotoCredit photo={p} lang={lang}/></figcaption></figure>)}</section><dialog class="photo-dialog" aria-label={t(lang,'Enlarged bird photograph','পাখির বড় ছবি')}><button type="button" data-photo-close aria-label={t(lang,'Close photograph','ছবি বন্ধ করুন')}>×</button><img src={url(images[0].src)} alt=""/><p></p></dialog></>}
<script>
const dialog=document.querySelector<HTMLDialogElement>('.photo-dialog');let focus:HTMLElement|null=null;
if(dialog&&typeof dialog.showModal==='function'){
 document.querySelectorAll<HTMLAnchorElement>('[data-photo-zoom]').forEach(a=>a.addEventListener('click',e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();focus=a;const source=a.querySelector('img')!;const image=dialog.querySelector('img')!;image.src=a.href;image.alt=source.alt;dialog.querySelector('p')!.textContent=a.closest('figure')!.querySelector('figcaption')!.textContent;dialog.showModal()}));
 dialog.querySelector('[data-photo-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});dialog.addEventListener('close',()=>focus?.focus());
}
</script>
