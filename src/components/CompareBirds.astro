---
import birds from '../data/birds.json';import traits from '../data/care-traits.json';import {primaryPhoto} from '../data/media';import {url,t,type Lang} from '../data/site';
interface Props {lang:Lang}const {lang}=Astro.props;const options=birds.map(b=>({...b,photo:primaryPhoto(b.slug)?.srcset[0]?.src}));
---
<section class="tool-section" id="compare"><h2>{t(lang,'Compare everyday life','কার সঙ্গে কেমন জীবন')}</h2><p>{t(lang,'Choose two or three species. Compare the work that changes between them: sound, dust, flight, food, companionship and cleanup.','দুটি বা তিনটি প্রজাতি বাছুন। ডাক, ধুলো, উড়বার জায়গা, খাবার, সঙ্গ ও পরিষ্কারের কাজে কোথায় পার্থক্য—একসঙ্গে দেখুন।')}</p><form id="compare-form" class="compare-selects">{[0,1,2].map((i)=><label>{t(lang,`Bird ${i+1}${i===2?' (optional)':''}`,`${i+1} নম্বর পাখি${i===2?' (ঐচ্ছিক)':''}`)}<select name={`bird${i}`} aria-label={t(lang,`Bird ${i+1}`,`${i+1} নম্বর পাখি`)}>{i===2&&<option value="">{t(lang,'None','বাছছি না')}</option>}{birds.map(b=><option value={b.slug} selected={b.slug===['budgerigar','cockatiel','green-cheeked-conure'][i]}>{b[lang]}</option>)}</select></label>)}</form><label class="inline-check"><input id="differences-only" type="checkbox" checked/>{t(lang,'Show differences only','শুধু পার্থক্যগুলো দেখান')}</label><p id="compare-status" role="status"></p><div id="comparison" class="table-scroll" tabindex="0" aria-label={t(lang,'Bird comparison','পাখির তুলনা')}></div><p class="muted">{t(lang,'These are general care patterns, not guarantees about a particular bird. Native wildlife is identified in the encyclopedia and is not offered as a pet recommendation.','এগুলো সাধারণ যত্নের ধরন; কোনো নির্দিষ্ট পাখির স্বভাবের নিশ্চয়তা নয়। দেশীয় বন্য পাখির পরিচিতি বিশ্বকোষে আছে; এখানে পোষার সুপারিশ করা হচ্ছে না।')}</p><noscript>{t(lang,'Open two species profiles to compare their care. The interactive table needs JavaScript.','দুটি প্রোফাইল খুলে যত্নের চাহিদা মিলিয়ে দেখতে পারেন। এই ছকের জন্য জাভাস্ক্রিপ্ট দরকার।')}</noscript></section>
<script define:vars={{options,traits,lang,base:url('')}}>
const selects=[...document.querySelectorAll('#compare-form select')];const bn=lang==='bn';const text=(pair)=>pair[bn?1:0];
const params=new URLSearchParams(location.search).get('compare')?.split(',');if(params){selects.forEach((el,i)=>{if(params[i]&&options.some(b=>b.slug===params[i]))el.value=params[i];else if(i===2)el.value=''})}
const rows=[['body',['Appearance','চেহারা']],['sound',['Sound at home','ঘরে কেমন ডাক']],['social',['Companionship','সঙ্গের চাহিদা']],['housing',['Space & activity','জায়গা ও চলাফেরা']],['diet',['Feeding pattern','খাবারের ধরন']],['dust',['Feather dust','পালকের ধুলো']],['cleanup',['Daily cleanup','দৈনিক পরিষ্কার']],['interaction',['Time together','একসঙ্গে সময়']],['watchOut',['Before choosing','বাছার আগে ভাবুন']]];
function renderCompare(){const address=new URL(location.href);address.searchParams.set('compare',selects.map(s=>s.value).filter(Boolean).join(','));history.replaceState(null,'',address);const chosen=selects.map(s=>options.find(b=>b.slug===s.value)).filter(Boolean);const ids=chosen.map(b=>b.slug);const target=document.querySelector('#comparison');target.replaceChildren();if(new Set(ids).size!==ids.length){document.querySelector('#compare-status').textContent=bn?'একই পাখি দুবার বাছা হয়েছে। আলাদা প্রজাতি বাছুন।':'Choose different species; a bird is selected twice.';return}if(chosen.length<2)return;const table=document.createElement('table');table.className='comparison-table';const head=document.createElement('thead');const hr=document.createElement('tr');const first=document.createElement('th');first.textContent=bn?'দৈনন্দিন চাহিদা':'Everyday needs';first.scope='col';hr.append(first);chosen.forEach(b=>{const th=document.createElement('th');th.scope='col';const a=document.createElement('a');a.href=`${base}${lang}/birds/${b.slug}/`;if(b.photo){const img=document.createElement('img');img.src=base+b.photo.replace(/^\//,'');img.alt='';img.width=120;img.height=90;a.append(img)}const label=document.createElement('span');label.textContent=b[lang];a.append(label);th.append(a);hr.append(th)});head.append(hr);table.append(head);const body=document.createElement('tbody');let shown=0;for(const [key,label] of rows){const values=chosen.map(b=>{const record=traits.species[b.slug];return key==='watchOut'?text(record.watchOut):text(traits.labels[key][record[key]])});if(document.querySelector('#differences-only').checked&&new Set(values).size===1)continue;const tr=document.createElement('tr');tr.dataset.trait=key;const th=document.createElement('th');th.scope='row';th.textContent=text(label);tr.append(th);values.forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td)});body.append(tr);shown++}table.append(body);target.append(table);document.querySelector('#compare-status').textContent=bn?`${chosen.length}টি পাখি · ${shown}টি দিক তুলনা করছেন। পাশের ঘরগুলো স্ক্রল করে দেখুন।`:`Comparing ${chosen.length} birds across ${shown} care factors. Scroll the table to see each bird.`;}
document.querySelector('#compare-form').addEventListener('change',renderCompare);document.querySelector('#compare-form').addEventListener('submit',e=>e.preventDefault());document.querySelector('#differences-only').addEventListener('change',renderCompare);renderCompare();
</script>
