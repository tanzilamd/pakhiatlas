---
import {url,t,type Lang} from '../data/site';interface Props{lang:Lang}const {lang}=Astro.props;
const initial=[['bird','Bird or pair quote','পাখি বা জোড়ার দর'],['housing','Housing / flight setup','খাঁচা বা ফ্লাইটের ব্যবস্থা'],['equipment','Perches, carrier & toys','ডাল, ক্যারিয়ার ও খেলনা'],['vet','Initial veterinary visit','প্রাথমিক চিকিৎসক দেখানো'],['transport','Transport','যাতায়াত'],['reserve','Emergency reserve','জরুরি সঞ্চয়']];const monthly=[['food','Food & vegetables','খাবার ও সবজি'],['cleaning','Cleaning & replacements','পরিষ্কার ও বদলানোর জিনিস'],['saving','Veterinary savings','চিকিৎসার জন্য সঞ্চয়']];
---
<section class="tool-section" id="budget"><h2>{t(lang,'Dhaka buying-budget worksheet','ঢাকায় পাখি আনার বাজেট')}</h2><p>{t(lang,'Enter quotes you obtain in taka. These are your figures, not preset market prices. Include housing and ongoing care as well as the bird.','আপনার পাওয়া দর টাকায় লিখুন। এগুলো আপনার হিসাব; আগে থেকে বসানো বাজারদর নয়। পাখির সঙ্গে বাসা ও নিয়মিত যত্নের খরচও ধরুন।')}</p><form id="budget-form"><fieldset><legend>{t(lang,'Initial costs (৳)','শুরুর খরচ (৳)')}</legend><div class="budget-inputs">{initial.map(([name,en,bn])=><label>{t(lang,en,bn)}<input type="number" min="0" step="any" inputmode="decimal" name={name} data-cost="initial" placeholder="0" required={name==='bird'}/></label>)}</div></fieldset><fieldset><legend>{t(lang,'Monthly costs (৳)','প্রতি মাসের খরচ (৳)')}</legend><div class="budget-inputs">{monthly.map(([name,en,bn])=><label>{t(lang,en,bn)}<input type="number" min="0" step="any" inputmode="decimal" name={name} data-cost="monthly" placeholder="0"/></label>)}</div></fieldset><button type="submit">{t(lang,'Calculate','হিসাব করুন')} →</button><button type="reset">{t(lang,'Clear','মুছুন')}</button></form><div id="budget-result" class="budget-result" aria-live="polite" hidden></div><p class="tool-reading"><a href={url(`${lang}/guides/dhaka-bird-budget/`)}>{t(lang,'How to compare Dhaka price quotes','ঢাকায় পাখির দর কীভাবে তুলবেন')} →</a></p><noscript>{t(lang,'Add the quoted initial costs, then keep monthly care and emergency funds separate.','শুরুর দরগুলো যোগ করুন; মাসিক যত্ন ও জরুরি সঞ্চয় আলাদা রাখুন।')}</noscript></section>
<script>
const form=document.querySelector<HTMLFormElement>('#budget-form')!;const out=document.querySelector<HTMLElement>('#budget-result')!;const bn=document.documentElement.lang==='bn';const currency=new Intl.NumberFormat(bn?'bn-BD':'en-BD',{style:'currency',currency:'BDT',maximumFractionDigits:0});
form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;let initial=0,monthly=0;form.querySelectorAll<HTMLInputElement>('[data-cost]').forEach(i=>{const n=Number(i.value||0);if(i.dataset.cost==='initial')initial+=n;else monthly+=n});out.hidden=false;out.replaceChildren();for(const [label,value] of [[bn?'শুরুর মোট খরচ':'Initial total',initial],[bn?'প্রতি মাসে':'Monthly total',monthly],[bn?'প্রথম বছর: শুরুর খরচ + ১২ মাস':'First year: initial + 12 months',initial+monthly*12]] as [string,number][]){const p=document.createElement('p');const strong=document.createElement('strong');strong.textContent=currency.format(value);p.append(label+' · ',strong);out.append(p)}});form.addEventListener('reset',()=>{out.hidden=true;out.replaceChildren()});
</script>
